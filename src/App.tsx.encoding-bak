const initialProfile: UserProfile = {
  ageRange: "26-35",
  gender: "涓嶄究閫忛湶",
  region: "涓浗澶ч檰",
  favoriteGenres: ["绉戝够", "鎮枒", "娌绘剤"],
  commonPlatforms: ["鑵捐瑙嗛", "鐖卞鑹?, "Disney+"],
  subtitleScale: 100,
  manualSubtitle: false,
  privacySettings: {
    useAge: true,
    useGender: false,
  },
};

function makeRecord(
  movieId: string,
  status: MovieStatus,
  priority: Priority,
  lists: string[],
  progress: number,
): UserMovieRecord {
  return {
    movieId,
    status,
    priority,
    lists,
    progress,
    rating: 0,
    review: "",
    watchDate: "",
    watchPlatform: "",
    tags: [],
    companions: [],
    createdAt: new Date().toISOString(),
    updatedAt: new Date().toISOString(),
  };
}

function createInitialState(): AppState {
  return {
    movies: seedMovies,
    records: initialRecords,
    profile: initialProfile,
    discussions: {},
  };
}

function loadState(): AppState {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (!raw) return createInitialState();
    const parsed = JSON.parse(raw) as AppState;
    return {
      movies: mergeMovies(parsed.movies),
      records: normalizeRecords({ ...initialRecords, ...(parsed.records ?? {}) }),
      profile: { ...initialProfile, ...parsed.profile },
      discussions: normalizeDiscussions(parsed.discussions),
    };
  } catch {
    return createInitialState();
  }
}

function normalizeDiscussions(discussions: Record<string, DiscussionComment[]> | undefined) {
  if (!discussions) return {};
  return Object.fromEntries(
    Object.entries(discussions).map(([movieId, comments]) => [
      movieId,
      comments.map((comment) => ({
        ...comment,
        movieId: comment.movieId || movieId,
        parentId: comment.parentId ?? null,
        likes: Math.max(0, Number(comment.likes) || 0),
        likedByMe: Boolean(comment.likedByMe),
      })),
    ]),
  );
}

function normalizeRecords(records: Record<string, UserMovieRecord>) {
  return Object.fromEntries(
    Object.entries(records).map(([id, record]) => [
      id,
      {
        ...record,
        rating: normalizeRating(record.rating),
      },
    ]),
  );
}

function mergeMovies(savedMovies: Movie[] | undefined) {
  if (!savedMovies?.length) return seedMovies;
  const savedIds = new Set(savedMovies.map((movie) => movie.id));
  return [...savedMovies, ...seedMovies.filter((movie) => !savedIds.has(movie.id))];
}

function loadAuth(): AuthSession | null {
  try {
    const raw = localStorage.getItem(AUTH_KEY);
    return raw ? (JSON.parse(raw) as AuthSession) : null;
  } catch {
    localStorage.removeItem(AUTH_KEY);
    return null;
  }
}

function normalizeState(value: unknown): AppState {
  const parsed = value as Partial<AppState> | null | undefined;
  return {
    movies: mergeMovies(parsed?.movies),
    records: normalizeRecords({ ...initialRecords, ...(parsed?.records ?? {}) }),
    profile: { ...initialProfile, ...(parsed?.profile ?? {}) },
    discussions: normalizeDiscussions(parsed?.discussions),
  };
}

async function apiRequest<T>(path: string, options: RequestInit = {}, token?: string): Promise<T> {
  const response = await fetch(`${API_BASE}${path}`, {
    ...options,
    headers: {
      "Content-Type": "application/json",
      ...(token ? { Authorization: `Bearer ${token}` } : {}),
      ...(options.headers ?? {}),
    },
  });
  const payload = await response.json().catch(() => ({}));
  if (!response.ok) {
    throw new Error(payload.error ?? "璇锋眰澶辫触锛岃绋嶅悗閲嶈瘯銆?);
  }
  return payload as T;
}

async function saveRemoteState(token: string, state: AppState) {
  await apiRequest<{ ok: true }>("/state", {
    method: "PUT",
    body: JSON.stringify({ state }),
  }, token);
}

function loadDiscussionLikes() {
  try {
    const raw = localStorage.getItem(DISCUSSION_LIKES_KEY);
    return raw ? (JSON.parse(raw) as string[]) : [];
  } catch {
    localStorage.removeItem(DISCUSSION_LIKES_KEY);
    return [];
  }
}

function splitText(value: string) {
  return value
    .split(/[,锛屻€乗n]/)
    .map((item) => item.trim())
    .filter(Boolean);
}

function App() {
  const [state, setState] = useState<AppState>(() => loadState());
  const [auth, setAuth] = useState<AuthSession | null>(() => loadAuth());
  const [guestMode, setGuestMode] = useState(() => localStorage.getItem(GUEST_KEY) === "true");
  const [authMode, setAuthMode] = useState<AuthMode>("login");
  const [authForm, setAuthForm] = useState({ username: "", password: "", displayName: "" });
  const [authError, setAuthError] = useState("");
  const [authBusy, setAuthBusy] = useState(false);
  const [stateReady, setStateReady] = useState(false);
  const [syncStatus, setSyncStatus] = useState("鏈櫥褰?);
  const [activeTab, setActiveTab] = useState<Tab>("home");
  const [query, setQuery] = useState("");
  const [statusFilter, setStatusFilter] = useState<MovieStatus | "鍏ㄩ儴">("鍏ㄩ儴");
  const [editingId, setEditingId] = useState<string | null>(null);
  const [skippedIds, setSkippedIds] = useState<string[]>([]);
  const [selectedMovieId, setSelectedMovieId] = useState<string | null>(null);
  const [watchState, setWatchState] = useState<{ movieId: string; positionSeconds: number; playing: boolean } | null>(null);
  const [form, setForm] = useState<MovieForm>(emptyForm());
  const [chatInput, setChatInput] = useState("");
  const [likedDiscussionIds, setLikedDiscussionIds] = useState<string[]>(() => loadDiscussionLikes());
  const [roomDraft, setRoomDraft] = useState<WatchRoomDraft>(() => ({
    movieId: state.movies[0]?.id ?? "",
    platformName: state.movies[0]?.platforms[0]?.platformName ?? platformOptions[0],
    hostName: "鎴?,
    friendName: "濂藉弸",
  }));
  const [watchRoom, setWatchRoom] = useState<WatchRoom | null>(null);
  const [picker, setPicker] = useState<PickerInput>({
    availableMinutes: 120,
    mood: "鐑ц剳",
    companion: "鐙嚜",
    platforms: state.profile.commonPlatforms,
    genres: state.profile.favoriteGenres,
    contentTypes: ["鐢靛奖", "鍓ч泦", "鍔ㄦ极", "绾綍鐗?, "缁艰壓", "鐭墽"],
  });

  useEffect(() => {
    if (auth) {
      localStorage.setItem(AUTH_KEY, JSON.stringify(auth));
    } else {
      localStorage.removeItem(AUTH_KEY);
    }
  }, [auth]);

  useEffect(() => {
    if (guestMode) {
      localStorage.setItem(GUEST_KEY, "true");
    } else {
      localStorage.removeItem(GUEST_KEY);
    }
  }, [guestMode]);

  useEffect(() => {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
  }, [state]);

  useEffect(() => {
    localStorage.setItem(DISCUSSION_LIKES_KEY, JSON.stringify(likedDiscussionIds));
  }, [likedDiscussionIds]);

  useEffect(() => {
    let cancelled = false;
    if (!auth?.token) {
      setStateReady(guestMode);
      setSyncStatus(guestMode ? "娓稿妯″紡锛屼粎鏈満淇濆瓨" : "鏈櫥褰?);
      return;
    }

    setSyncStatus("姝ｅ湪璇诲彇璐﹀彿鏁版嵁...");
    apiRequest<{ state: AppState | null }>("/state", {}, auth.token)
      .then(async ({ state: remoteState }) => {
        if (cancelled) return;
        if (remoteState) {
          setState(normalizeState(remoteState));
          setSyncStatus("璐﹀彿鏁版嵁宸插姞杞?);
        } else {
          await saveRemoteState(auth.token, state);
          if (!cancelled) setSyncStatus("宸叉妸鏈満鏁版嵁瀵煎叆璐﹀彿");
        }
      })
      .catch((error: Error) => {
        if (!cancelled) {
          setAuthError(error.message);
          setAuth(null);
          setSyncStatus("鐧诲綍宸插け鏁?);
        }
      })
      .finally(() => {
        if (!cancelled) setStateReady(true);
      });

    return () => {
      cancelled = true;
    };
  }, [auth?.token]);

  useEffect(() => {
    if (!auth?.token || !stateReady) return;
    setSyncStatus("姝ｅ湪淇濆瓨...");
    const timer = window.setTimeout(() => {
      saveRemoteState(auth.token, state)
        .then(() => setSyncStatus("宸蹭繚瀛樺埌璐﹀彿"))
        .catch((error: Error) => setSyncStatus(error.message));
    }, 500);
    return () => window.clearTimeout(timer);
  }, [auth?.token, state, stateReady]);

  useEffect(() => {
    if (!("BroadcastChannel" in window)) return;
    const channel = new BroadcastChannel("cinelist-watch-chat");
    channel.onmessage = (event: MessageEvent<WatchChannelMessage>) => {
      if (event.data?.type === "request-state") {
        broadcastRoomState();
        return;
      }
      if (event.data?.type === "playback-command" && event.data.patch) {
        updatePlayback(event.data.patch, event.data.author || roomDraft.hostName.trim() || "鎴?);
        return;
      }
      if (event.data?.type === "send-message" && event.data.text?.trim()) {
        addRoomMessage(event.data.text, event.data.author || roomDraft.hostName.trim() || "鎴?);
      }
    };
    return () => channel.close();
  }, [roomDraft.hostName, watchRoom]);

  useEffect(() => {
    broadcastRoomState();
  }, [state.movies, watchRoom]);

  useEffect(() => {
    if (watchRoom?.playback.status !== "鎾斁涓?) return;
    const timer = window.setInterval(() => {
      setWatchRoom((current) => {
        if (!current || current.playback.status !== "鎾斁涓?) return current;
        const movie = state.movies.find((item) => item.id === current.movieId);
        const maxSeconds = Math.max((movie?.durationMinutes ?? 90) * 60, 60);
        const elapsedSeconds = (Date.now() - new Date(current.playback.updatedAt).getTime()) / 1000;
        const nextPosition = Math.min(
          maxSeconds,
          current.playback.positionSeconds + elapsedSeconds * current.playback.playbackRate,
        );
        return {
          ...current,
          playback: {
            ...current.playback,
            positionSeconds: Math.round(nextPosition),
            status: nextPosition >= maxSeconds ? "宸叉殏鍋? : current.playback.status,
            updatedAt: new Date().toISOString(),
          },
        };
      });
    }, 1000);
    return () => window.clearInterval(timer);
  }, [state.movies, watchRoom?.id, watchRoom?.playback.status]);

  function broadcastRoomState() {
    if (!watchRoom || !("BroadcastChannel" in window)) return;
    const channel = new BroadcastChannel("cinelist-watch-chat");
    channel.postMessage({
      type: "room-state",
      title: state.movies.find((movie) => movie.id === watchRoom.movieId)?.title ?? "涓€璧风湅",
      messages: watchRoom.messages,
      playback: watchRoom.playback,
    });
    channel.close();
  }

  useEffect(() => {
    if (
      state.profile.privacySettings.useAge &&
      isSenior(state.profile.ageRange) &&
      !state.profile.manualSubtitle &&
      state.profile.subtitleScale !== 130
    ) {
      setState((current) => ({
        ...current,
        profile: { ...current.profile, subtitleScale: 130 },
      }));
    }
  }, [state.profile.ageRange, state.profile.manualSubtitle, state.profile.privacySettings.useAge, state.profile.subtitleScale]);

  const movieRows = useMemo(() => {
    return state.movies.map((movie) => ({
      movie,
      record: state.records[movie.id],
    }));
  }, [state.movies, state.records]);

  const filteredRows = useMemo(() => {
    const lower = query.trim().toLowerCase();
    return movieRows.filter(({ movie, record }) => {
      const matchesQuery =
        !lower ||
        movie.title.toLowerCase().includes(lower) ||
        movie.alias.toLowerCase().includes(lower) ||
        movie.genres.join(",").toLowerCase().includes(lower);
      const matchesStatus =
        statusFilter === "鍏ㄩ儴" || (record?.status ?? "鎯崇湅") === statusFilter;
      return matchesQuery && matchesStatus;
    });
  }, [movieRows, query, statusFilter]);

  const genreScores = useMemo(() => calcGenreScores(movieRows, state.profile), [movieRows, state.profile]);
  const summary = useMemo(() => calcSummary(movieRows), [movieRows]);
  const ratingRank = useMemo(() => calcRatingRank(movieRows), [movieRows]);
  const heatRank = useMemo(() => calcSearchHeatRank(movieRows), [movieRows]);
  const costumeRank = useMemo(() => calcTagHeatRank(movieRows, ["鍙よ", "姝︿緺", "浠欎緺", "鍘嗗彶"]), [movieRows]);
  const urbanRank = useMemo(() => calcTagHeatRank(movieRows, ["閮藉競", "鐖辨儏", "鑱屽満", "瀹跺涵"]), [movieRows]);
  const shortDramaRank = useMemo(() => calcShortDramaRank(movieRows), [movieRows]);
  const yingjiRank = useMemo(() => calcYingjiRank(movieRows), [movieRows]);
  const categoryRanks = useMemo(() => calcCategoryRanks(movieRows), [movieRows]);
  const recommendations = useMemo(
    () => recommend(movieRows, picker, state.profile, skippedIds),
    [movieRows, picker, state.profile, skippedIds],
  );
  const draftMovie = useMemo(
    () => state.movies.find((movie) => movie.id === roomDraft.movieId) ?? state.movies[0],
    [roomDraft.movieId, state.movies],
  );

  function saveMovie(event: FormEvent) {
    event.preventDefault();
    const id = editingId ?? makeId("m-");
    const movie: Movie = {
      id,
      title: form.title.trim() || "鏈懡鍚嶅奖鐗?,
      alias: form.alias.trim(),
      year: Number(form.year) || new Date().getFullYear(),
      type: form.type,
      genres: splitText(form.genres),
      durationMinutes: Number(form.durationMinutes) || 90,
      poster: form.poster.trim().slice(0, 2) || form.title.trim().slice(0, 1) || "褰?,
      summary: form.summary.trim(),
      directors: splitText(form.directors),
      actors: splitText(form.actors),
      moods: inferMoods(splitText(form.genres)),
      companions: inferCompanions(splitText(form.genres), form.type),
      platforms: splitText(form.platforms).map((platformName) => ({
        platformName,
        region: state.profile.region,
        watchType: "鎼滅储鍏ュ彛",
        url: platformSearchUrl(platformName, form.title.trim()),
        lastCheckedAt: today,
        available: true,
      })),
    };

    setState((current) => {
      const existing = current.movies.some((item) => item.id === id);
      return {
        ...current,
        movies: existing
          ? current.movies.map((item) => (item.id === id ? movie : item))
          : [movie, ...current.movies],
        records: current.records[id]
          ? current.records
          : { ...current.records, [id]: makeRecord(id, "鎯崇湅", "鏈夋椂闂寸湅", [], 0) },
      };
    });
    setEditingId(null);
    setForm(emptyForm());
    setActiveTab("library");
  }

  function editMovie(movie: Movie) {
    setEditingId(movie.id);
    setForm({
      title: movie.title,
      alias: movie.alias,
      year: String(movie.year),
      type: movie.type,
      genres: movie.genres.join("銆?),
      durationMinutes: String(movie.durationMinutes),
      poster: movie.poster,
      summary: movie.summary,
      directors: movie.directors.join("銆?),
      actors: movie.actors.join("銆?),
      platforms: movie.platforms.map((item) => item.platformName).join("銆?),
    });
    setActiveTab("library");
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  function deleteMovie(id: string) {
    setState((current) => {
      const nextRecords = { ...current.records };
      delete nextRecords[id];
      return {
        ...current,
        movies: current.movies.filter((movie) => movie.id !== id),
        records: nextRecords,
      };
    });
  }

  function updateRecord(movieId: string, patch: Partial<UserMovieRecord>) {
    setState((current) => {
      const currentRecord = current.records[movieId] ?? makeRecord(movieId, "鎯崇湅", "鏈夋椂闂寸湅", [], 0);
      return {
        ...current,
        records: {
          ...current.records,
          [movieId]: {
            ...currentRecord,
            ...patch,
            updatedAt: new Date().toISOString(),
          },
        },
      };
    });
  }

  function createWatchRoom(movieId = roomDraft.movieId, startSeconds = 0) {
    const movie = state.movies.find((item) => item.id === movieId) ?? draftMovie;
    if (!movie) return;
    const platformName =
      (movieId !== roomDraft.movieId ? movie.platforms[0]?.platformName : roomDraft.platformName) ||
      roomDraft.platformName ||
      movie.platforms[0]?.platformName ||
      platformOptions[0];
    const roomId = makeId("room-").slice(0, 13);
    const inviteLink = `${window.location.origin}${window.location.pathname}#watch=${roomId}`;
    const hostName = roomDraft.hostName.trim() || "鎴?;
    const friendName = roomDraft.friendName.trim() || "濂藉弸";
    setWatchRoom({
      id: roomId,
      movieId: movie.id,
      platformName,
      hostName,
      inviteLink,
      members: [hostName, friendName],
      playback: {
        status: "宸叉殏鍋?,
        positionSeconds: startSeconds,
        playbackRate: 1,
        updatedAt: new Date().toISOString(),
        updatedBy: hostName,
      },
      messages: [
        {
          id: makeId(),
          author: "绯荤粺",
          text: `宸蹭负銆?{movie.title}銆嬪垱寤哄叡鐪嬫埧闂淬€傛寮忎笂绾垮悗锛岃繖涓摼鎺ヤ細鎶婂ソ鍙嬪甫鍏ュ悓涓€涓疄鏃舵埧闂淬€俙,
          createdAt: new Date().toISOString(),
        },
      ],
    });
    setRoomDraft((current) => ({ ...current, movieId: movie.id, platformName }));
    setActiveTab("party");
  }

  function updatePlayback(patch: Partial<PlaybackState>, updatedBy = roomDraft.hostName.trim() || "鎴?) {
    setWatchRoom((current) => {
      if (!current) return current;
      return {
        ...current,
        playback: {
          ...current.playback,
          ...patch,
          updatedAt: new Date().toISOString(),
          updatedBy,
        },
      };
    });
  }

  function sendRoomMessage(event: FormEvent) {
    event.preventDefault();
    const text = chatInput.trim();
    if (!text) return;
    addRoomMessage(text, roomDraft.hostName.trim() || "鎴?);
    setChatInput("");
  }

  function addRoomMessage(text: string, author: string) {
    setWatchRoom((current) => {
      if (!current) return current;
      return {
        ...current,
        messages: [
          ...current.messages,
          {
            id: makeId(),
            author,
            text,
            createdAt: new Date().toISOString(),
          },
        ],
      };
    });
  }

  function markDiscussionComments(movieId: string, comments: DiscussionComment[]) {
    setState((current) => ({
      ...current,
      discussions: {
        ...current.discussions,
        [movieId]: comments.map((comment) => ({
          ...comment,
          likedByMe: likedDiscussionIds.includes(comment.id),
        })),
      },
    }));
  }

  async function loadDiscussionComments(movieId: string) {
    try {
      const payload = await apiRequest<{ comments: DiscussionComment[] }>(`/discussions/${encodeURIComponent(movieId)}`);
      markDiscussionComments(movieId, payload.comments);
    } catch {
      setState((current) => ({
        ...current,
        discussions: {
          ...current.discussions,
          [movieId]: current.discussions[movieId] ?? [],
        },
      }));
    }
  }

  async function addDiscussionComment(movieId: string, text: string, parentId: string | null) {
    const trimmed = text.trim();
    if (!trimmed) return;
    const author = auth?.user?.displayName ?? auth?.user?.username ?? "娓稿";
    setActiveTab("discussion");
    try {
      const payload = await apiRequest<{ comment: DiscussionComment }>(`/discussions/${encodeURIComponent(movieId)}`, {
        method: "POST",
        body: JSON.stringify({ text: trimmed, parentId, author }),
      });
      setState((current) => ({
        ...current,
        discussions: {
          ...current.discussions,
          [movieId]: [
            ...(current.discussions[movieId] ?? []),
            { ...payload.comment, likedByMe: false },
          ],
        },
      }));
      return;
    } catch {
      // Keep a local fallback so discussion remains usable while the public API is offline.
    }
    setState((current) => ({
      ...current,
      discussions: {
        ...current.discussions,
        [movieId]: [
          ...(current.discussions[movieId] ?? []),
          {
            id: makeId(),
            movieId,
            parentId,
            author,
            text: trimmed,
            likes: 0,
            likedByMe: false,
            createdAt: new Date().toISOString(),
          },
        ],
      },
    }));
  }

  async function toggleDiscussionLike(movieId: string, commentId: string) {
    const likedByMe = !likedDiscussionIds.includes(commentId);
    const nextLikedIds = likedByMe
      ? [...likedDiscussionIds, commentId]
      : likedDiscussionIds.filter((id) => id !== commentId);
    setLikedDiscussionIds(nextLikedIds);
    try {
      await apiRequest<{ comment: DiscussionComment }>(`/discussions/${encodeURIComponent(movieId)}/${encodeURIComponent(commentId)}/like`, {
        method: "POST",
        body: JSON.stringify({ delta: likedByMe ? 1 : -1 }),
      });
    } catch {
      // Local fallback below still updates the visible like state.
    }
    setState((current) => ({
      ...current,
      discussions: {
        ...current.discussions,
        [movieId]: (current.discussions[movieId] ?? []).map((comment) => {
          if (comment.id !== commentId) return comment;
          return {
            ...comment,
            likedByMe,
            likes: Math.max(0, comment.likes + (likedByMe ? 1 : -1)),
          };
        }),
      },
    }));
  }

  function startWatchParty(movie: Movie, startSeconds = 0) {
    setRoomDraft((current) => ({
      ...current,
      movieId: movie.id,
      platformName: movie.platforms[0]?.platformName ?? current.platformName,
    }));
    createWatchRoom(movie.id, startSeconds);
  }

  function startSoloWatch(movie: Movie, startSeconds = 0) {
    setWatchState({ movieId: movie.id, positionSeconds: startSeconds, playing: true });
    updateRecord(movie.id, {
      status: "鍦ㄧ湅",
      progress: Math.min(99, Math.round((startSeconds / Math.max(movie.durationMinutes * 60, 1)) * 100)),
      watchPlatform: movie.platforms[0]?.platformName ?? "",
    });
    setActiveTab("watch");
  }

  function toggleArrayField<T extends string>(
    value: T,
    current: T[],
    update: (next: T[]) => void,
  ) {
    update(current.includes(value) ? current.filter((item) => item !== value) : [...current, value]);
  }

  async function submitAuth(event: FormEvent) {
    event.preventDefault();
    setAuthBusy(true);
    setAuthError("");
    try {
      const payload = await apiRequest<{ token: string; user: AuthUser }>(
        authMode === "login" ? "/auth/login" : "/auth/register",
        {
          method: "POST",
          body: JSON.stringify(authForm),
        },
      );
      setGuestMode(false);
      setAuth({ token: payload.token, user: payload.user });
      setAuthForm({ username: "", password: "", displayName: "" });
    } catch (error) {
      setAuthError(error instanceof Error ? error.message : "鐧诲綍澶辫触锛岃绋嶅悗閲嶈瘯銆?);
    } finally {
      setAuthBusy(false);
    }
  }

  function logout() {
    setAuth(null);
    setStateReady(false);
    setAuthError("");
  }

  function enterGuestMode() {
    setGuestMode(true);
    setStateReady(true);
    setAuthError("");
    setSyncStatus("娓稿妯″紡锛屼粎鏈満淇濆瓨");
  }

  function leaveGuestMode() {
    setGuestMode(false);
    setStateReady(false);
    setAuthError("");
  }

  if (!auth && !guestMode) {
    return (
      <AuthView
        mode={authMode}
        setMode={setAuthMode}
        form={authForm}
        setForm={setAuthForm}
        error={authError}
        busy={authBusy}
        submit={submitAuth}
        enterGuestMode={enterGuestMode}
      />
    );
  }

  if (!stateReady) {
    return (
      <main className="auth-shell">
        <section className="auth-panel">
          <p className="eyebrow">CineList</p>
          <h1>姝ｅ湪杩涘叆浣犵殑鐗囧崟</h1>
          <p>{syncStatus}</p>
        </section>
      </main>
    );
  }

  return (
    <main>
      <aside className="rail" aria-label="涓昏瀵艰埅">
        <div className="brand">
          <span className="brand-mark">褰?/span>
          <div>
            <strong>褰辫抗</strong>
            <small>CineList</small>
          </div>
        </div>
        <nav>
          {[
            ["home", "棣栭〉"],
            ["library", "鎴戠殑鐗囧崟"],
            ["picker", "蹇€熼€夌墖"],
            ["rankings", "鎺掕姒?],
            ["watch", "瑙傜湅"],
            ["party", "涓€璧风湅"],
            ["discussion", "璁ㄨ鍖?],
            ["summary", "涓汉鎬荤粨"],
            ["settings", "璁剧疆"],
          ].map(([key, label]) => (
            <button
              className={activeTab === key ? "active" : ""}
              key={key}
              onClick={() => setActiveTab(key as Tab)}
            >
              {label}
            </button>
          ))}
        </nav>
        <div className="subtitle-card">
          <span>瀛楀箷棰勮</span>
          <strong>{state.profile.subtitleScale}%</strong>
          <p style={{ fontSize: `${Math.min(state.profile.subtitleScale, 160) / 100}rem` }}>
            浠婃櫄鐪嬩粈涔堬紵
          </p>
        </div>
        <div className="account-card">
          <span>{auth ? "褰撳墠璐﹀彿" : "褰撳墠妯″紡"}</span>
          <strong>{auth?.user?.displayName ?? auth?.user?.username ?? "娓稿璁块棶"}</strong>
          <small>{syncStatus}</small>
          <button onClick={auth ? logout : leaveGuestMode}>{auth ? "閫€鍑虹櫥褰? : "鐧诲綍璐﹀彿"}</button>
        </div>
      </aside>

      <section className="workspace">
        {activeTab === "home" && (
          <HomeView
            rows={movieRows}
            genreScores={genreScores}
            summary={summary}
            ratingRank={ratingRank}
            heatRank={heatRank}
            recommendations={recommendations}
            query={query}
            setQuery={setQuery}
            openPicker={() => setActiveTab("picker")}
            openLibrary={() => setActiveTab("library")}
            openParty={() => setActiveTab("party")}
            updateRecord={updateRecord}
            startWatchParty={startWatchParty}
            startSoloWatch={startSoloWatch}
            openMovie={(movie) => setSelectedMovieId(movie.id)}
          />
        )}

        {activeTab === "library" && (
          <LibraryView
            form={form}
            setForm={setForm}
            saveMovie={saveMovie}
            editingId={editingId}
            cancelEdit={() => {
              setEditingId(null);
              setForm(emptyForm());
            }}
            rows={filteredRows}
            query={query}
            setQuery={setQuery}
            statusFilter={statusFilter}
            setStatusFilter={setStatusFilter}
            updateRecord={updateRecord}
            editMovie={editMovie}
            deleteMovie={deleteMovie}
          />
        )}

        {activeTab === "picker" && (
          <PickerView
            picker={picker}
            setPicker={setPicker}
            recommendations={recommendations}
            skippedIds={skippedIds}
            skipBatch={() => setSkippedIds([...new Set([...skippedIds, ...recommendations.map((item) => item.movie.id)])])}
            resetSkipped={() => setSkippedIds([])}
            updateRecord={updateRecord}
            startWatchParty={startWatchParty}
          />
        )}

        {activeTab === "party" && (
          <WatchPartyView
            movies={state.movies}
            draft={roomDraft}
            setDraft={setRoomDraft}
            room={watchRoom}
            chatInput={chatInput}
            setChatInput={setChatInput}
            createRoom={() => createWatchRoom()}
            sendMessage={sendRoomMessage}
            updatePlayback={updatePlayback}
          />
        )}

        {activeTab === "discussion" && (
          <DiscussionView
            movies={state.movies}
            records={state.records}
            discussions={state.discussions}
            loadDiscussions={loadDiscussionComments}
            addComment={addDiscussionComment}
            toggleLike={toggleDiscussionLike}
            goHome={() => setActiveTab("home")}
            startSoloWatch={startSoloWatch}
            startWatchParty={startWatchParty}
          />
        )}

        {activeTab === "watch" && (
          <SoloWatchView
            rows={movieRows}
            row={movieRows.find(({ movie }) => movie.id === watchState?.movieId)}
            watchState={watchState}
            setWatchState={setWatchState}
            updateRecord={updateRecord}
            startSoloWatch={startSoloWatch}
          />
        )}

        {activeTab === "rankings" && (
          <RankingsView
            ratingRank={ratingRank}
            heatRank={heatRank}
            costumeRank={costumeRank}
            urbanRank={urbanRank}
            shortDramaRank={shortDramaRank}
            yingjiRank={yingjiRank}
            categoryRanks={categoryRanks}
            openMovie={(movie) => setSelectedMovieId(movie.id)}
          />
        )}

        {activeTab === "summary" && (
          <SummaryView rows={movieRows} summary={summary} genreScores={genreScores} />
        )}

        {activeTab === "settings" && (
          <SettingsView
            profile={state.profile}
            setProfile={(profile) => setState((current) => ({ ...current, profile }))}
            resetData={() => setState(createInitialState())}
            toggleArrayField={toggleArrayField}
          />
        )}
      </section>
      <MovieDetailModal
        row={movieRows.find(({ movie }) => movie.id === selectedMovieId)}
        close={() => setSelectedMovieId(null)}
        updateRecord={updateRecord}
        startSoloWatch={startSoloWatch}
        startWatchParty={startWatchParty}
      />
    </main>
  );
}

function emptyForm(): MovieForm {
  return {
    title: "",
    alias: "",
    year: "2026",
    type: "鐢靛奖",
    genres: "鍓ф儏",
    durationMinutes: "100",
    poster: "",
    summary: "",
    directors: "",
    actors: "",
    platforms: "鑵捐瑙嗛",
  };
}

function AuthView(props: {
  mode: AuthMode;
  setMode: (mode: AuthMode) => void;
  form: { username: string; password: string; displayName: string };
  setForm: (form: { username: string; password: string; displayName: string }) => void;
  error: string;
  busy: boolean;
  submit: (event: FormEvent) => void;
  enterGuestMode: () => void;
}) {
  const isRegister = props.mode === "register";
  return (
    <main className="auth-shell">
      <section className="auth-panel">
        <div className="brand">
          <span className="brand-mark">褰?/span>
          <div>
            <strong>褰辫抗 CineList</strong>
            <small>鐧诲綍鍚庯紝浣犵殑鐗囧崟浼氫繚瀛樺埌璐﹀彿閲屻€?/small>
          </div>
        </div>
        <div>
          <p className="eyebrow">璐﹀彿绯荤粺</p>
          <h1>{isRegister ? "鍒涘缓浣犵殑瑙傚奖璐﹀彿" : "鐧诲綍浣犵殑瑙傚奖鐗囧崟"}</h1>
          <p>鍚屽鍙互鍚勮嚜娉ㄥ唽璐﹀彿锛屾敹钘忋€佽瘎鍒嗐€佽繘搴﹀拰涓汉璁剧疆浼氬垎鍒繚瀛樸€?/p>
        </div>
        <form className="auth-form" onSubmit={props.submit}>
          {isRegister && (
            <Input
              label="鏄电О"
              value={props.form.displayName}
              onChange={(displayName) => props.setForm({ ...props.form, displayName })}
            />
          )}
          <Input
            label="鐢ㄦ埛鍚?
            value={props.form.username}
            onChange={(username) => props.setForm({ ...props.form, username })}
            required
          />
          <label>
            瀵嗙爜
            <input
              required
              minLength={6}
              type="password"
              value={props.form.password}
              onChange={(event) => props.setForm({ ...props.form, password: event.target.value })}
            />
          </label>
          {props.error && <p className="form-error">{props.error}</p>}
          <button className="primary" disabled={props.busy}>
            {props.busy ? "澶勭悊涓?.." : isRegister ? "娉ㄥ唽骞惰繘鍏? : "鐧诲綍"}
          </button>
        </form>
        <button
          className="text-button"
          onClick={() => props.setMode(isRegister ? "login" : "register")}
        >
          {isRegister ? "宸叉湁璐﹀彿锛屽幓鐧诲綍" : "娌℃湁璐﹀彿锛屽幓娉ㄥ唽"}
        </button>
        <button className="guest-button" onClick={props.enterGuestMode}>
          璺宠繃鐧诲綍锛屼互娓稿韬唤璁块棶
        </button>
        <p className="guest-note">娓稿鏁版嵁鍙繚瀛樺湪褰撳墠娴忚鍣紝鎹㈣澶囨垨娓呯悊缂撳瓨鍚庢棤娉曟壘鍥炪€?/p>
      </section>
    </main>
  );
}

function HomeView(props: {
  rows: { movie: Movie; record?: UserMovieRecord }[];
  genreScores: { genre: string; score: number }[];
  summary: ReturnType<typeof calcSummary>;
  ratingRank: ReturnType<typeof calcRatingRank>;
  heatRank: ReturnType<typeof calcSearchHeatRank>;
  recommendations: ReturnType<typeof recommend>;
  query: string;
  setQuery: (value: string) => void;
  openPicker: () => void;
  openLibrary: () => void;
  openParty: () => void;
  updateRecord: (movieId: string, patch: Partial<UserMovieRecord>) => void;
  startWatchParty: (movie: Movie, startSeconds?: number) => void;
  startSoloWatch: (movie: Movie, startSeconds?: number) => void;
  openMovie: (movie: Movie) => void;
}) {
  const [submittedQuery, setSubmittedQuery] = useState("");
  const recent = props.rows
    .filter(({ record }) => record)
    .sort((a, b) => (b.record?.updatedAt ?? "").localeCompare(a.record?.updatedAt ?? ""))
    .slice(0, 4);
  const watching = props.rows.filter(({ record }) => record?.status === "鍦ㄧ湅").slice(0, 3);
  const progressRows = props.rows
    .filter(({ record }) => (record?.progress ?? 0) > 0 && (record?.progress ?? 0) < 100)
    .sort((a, b) => (b.record?.updatedAt ?? "").localeCompare(a.record?.updatedAt ?? ""))
    .slice(0, 4);
  const searchResults = useMemo(() => {
    const keyword = submittedQuery.trim().toLowerCase();
    if (!keyword) return [];
    return props.rows
      .filter(({ movie }) => {
        const haystack = [
          movie.title,
          movie.alias,
          movie.summary,
          movie.genres.join(" "),
          movie.directors.join(" "),
          movie.actors.join(" "),
          movie.platforms.map((platform) => platform.platformName).join(" "),
        ].join(" ").toLowerCase();
        return haystack.includes(keyword);
      })
      .slice(0, 8);
  }, [props.rows, submittedQuery]);
  const onlineTargets = useMemo(() => webSearchTargets(submittedQuery), [submittedQuery]);

  return (
    <div className="page-stack">
      <section className="hero">
        <div>
          <p className="eyebrow">CineList MVP</p>
          <h1>浠婃櫄鐪嬩粈涔堬紝浜ょ粰涓€寮犱細璁板繂鐨勭墖鍗曘€?/h1>
          <p>
            鏀惰棌銆佸垎绫汇€佹煡骞冲彴銆佸揩閫熼€夌墖鍜屽啓璇勪环閮藉湪涓€涓湴鏂瑰畬鎴愶紝鍒锋柊椤甸潰鍚庢暟鎹粛淇濆瓨鍦ㄦ湰鏈烘祻瑙堝櫒銆?          </p>
          <form
            className="search-row"
            onSubmit={(event) => {
              event.preventDefault();
              setSubmittedQuery(props.query);
            }}
          >
            <input
              aria-label="鎼滅储褰辩墖"
              placeholder="鎼滅储褰辩墖銆佺被鍨嬫垨鑻辨枃鍚?
              value={props.query}
              onChange={(event) => props.setQuery(event.target.value)}
            />
            <button className="icon-button primary" type="submit" aria-label="鎼滅储褰辩墖">
              鈱?            </button>
            <button type="button" onClick={props.openLibrary}>绠＄悊鐗囧崟</button>
            <button type="button" onClick={props.openParty}>閭€璇峰叡鐪?/button>
            <button className="primary" type="button" onClick={props.openPicker}>
              蹇€熼€夌墖
            </button>
          </form>
          <div className="resume-strip" aria-label="缁х画瑙傜湅杩涘害">
            <div className="section-title">
              <h2>缁х画瑙傜湅</h2>
              <span>{progressRows.length ? "鐐瑰嚮鐩存帴瑙傜湅" : "鏆傛棤杩涘害"}</span>
            </div>
            {progressRows.length ? (
              <div className="resume-list">
                {progressRows.map(({ movie, record }) => {
                  const progress = Math.min(99, Math.max(1, record?.progress ?? 0));
                  const startSeconds = Math.floor(movie.durationMinutes * 60 * (progress / 100));
                  return (
                    <button className="resume-item" key={movie.id} onClick={() => props.startSoloWatch(movie, startSeconds)}>
                      <span className="poster small">{movie.poster}</span>
                      <div>
                        <strong>{movie.title}</strong>
                        <i><span style={{ width: `${progress}%` }} /></i>
                      </div>
                      <em>{progress}%</em>
                    </button>
                  );
                })}
              </div>
            ) : (
              <p className="resume-empty">寮€濮嬭鐪嬪悗锛岃繖閲屼細鏄剧ず涓婃杩涘害銆?/p>
            )}
          </div>
        </div>
        <div className="home-side">
          <div className="hero-panel">
            <span>鏈湀宸茬湅</span>
            <strong>{props.summary.watchedCount}</strong>
            <p>{props.summary.totalMinutes} 鍒嗛挓 路 骞冲潎 {props.summary.averageRating || "鏆傛棤"} 鍒?/p>
          </div>
          <RankList title="璇勫垎鎺掕姒? items={props.ratingRank} valueSuffix="鍒? onSelect={props.openMovie} />
          <RankList title="鎼滅储鐑害姒? items={props.heatRank} valueSuffix="鐑害" onSelect={props.openMovie} />
        </div>
      </section>

      <Panel title="涓汉鏀惰棌">
        <MovieGrid rows={recent} updateRecord={props.updateRecord} />
      </Panel>

      {submittedQuery.trim() && (
        <section className="search-results">
          <div className="section-title">
            <h2>鎼滅储缁撴灉锛歿submittedQuery}</h2>
            <span>{searchResults.length ? `${searchResults.length} 閮ㄥ奖鐗嘸 : "鏆傛棤鍖归厤"}</span>
          </div>
          {searchResults.length ? (
            <div className="result-grid">
              {searchResults.map(({ movie, record }) => (
                <article className="result-card" key={movie.id}>
                  <span className="poster">{movie.poster}</span>
                  <div>
                    <div className="card-title">
                      <h3>{movie.title}</h3>
                      <span>{movie.year} 路 {movie.type}</span>
                    </div>
                    <p>{movie.alias} 路 {movie.durationMinutes} 鍒嗛挓</p>
                    <p>{movie.summary || "鏆傛棤绠€浠?}</p>
                    <div className="chips">
                      {movie.genres.map((genre) => <span className="chip" key={genre}>{genre}</span>)}
                    </div>
                    <div className="platform-tags">
                      {movie.platforms.length ? movie.platforms.map((platform) => (
                        <a href={playableUrl(platform, movie.title)} key={platform.platformName} rel="noreferrer" target="_blank">
                          {platform.platformName} 路 {platform.watchType}
                        </a>
                      )) : <span>鏆傛棤骞冲彴淇℃伅</span>}
                    </div>
                  </div>
                  <div className="result-actions">
                    <button
                      className="primary"
                      onClick={() => props.updateRecord(movie.id, { status: "鍦ㄧ湅", progress: Math.max(record?.progress ?? 0, 10) })}
                    >
                      缁х画
                    </button>
                    <button onClick={() => props.startWatchParty(movie)}>鍏辩湅</button>
                  </div>
                  <div className="result-rating">
                    <RatingControl
                      value={normalizeRating(record?.rating ?? 0)}
                      onChange={(rating) => props.updateRecord(movie.id, { rating, status: rating > 0 ? "宸茬湅" : record?.status })}
                    />
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <EmptyState text="鐗囧簱閲屾病鏈夋壘鍒板尮閰嶅奖鐗囥€傚彲浠ユ崲涓叧閿瘝锛屾垨鍘烩€滄垜鐨勭墖鍗曗€濇柊澧炲奖鐗囦俊鎭€? />
          )}

          <div className="online-search">
            <div className="section-title">
              <h2>鍏ㄧ綉鎼滅储</h2>
              <span>{onlineTargets.length} 涓叆鍙?/span>
            </div>
            <div className="online-grid">
              {onlineTargets.map((target) => (
                <a href={target.url} key={target.name} rel="noreferrer" target="_blank">
                  <strong>{target.name}</strong>
                  <span>{target.description}</span>
                </a>
              ))}
            </div>
          </div>
        </section>
      )}

      <section className="metric-grid">
        <Metric label="鐗囧簱鎬绘暟" value={props.rows.length} />
        <Metric label="鎯崇湅" value={props.rows.filter(({ record }) => record?.status === "鎯崇湅").length} />
        <Metric label="鍦ㄧ湅" value={props.rows.filter(({ record }) => record?.status === "鍦ㄧ湅").length} />
        <Metric label="宸茶瘎浠? value={props.rows.filter(({ record }) => (record?.rating ?? 0) > 0).length} />
      </section>

      <section className="split">
        <Panel title="甯哥湅绫诲瀷">
          <div className="chips">
            {props.genreScores.slice(0, 6).map((item) => (
              <span className="chip strong" key={item.genre}>
                {item.genre} {item.score}
              </span>
            ))}
          </div>
        </Panel>
        <Panel title="鐚滀綘鍠滄">
          <div className="compact-list">
            {props.recommendations.slice(0, 3).map(({ movie, reasons }) => (
              <article key={movie.id}>
                <span className="poster small">{movie.poster}</span>
                <div>
                  <strong>{movie.title}</strong>
                  <p>{reasons[0]}</p>
                </div>
              </article>
            ))}
          </div>
        </Panel>
      </section>

      <section className="split">
        <Panel title="缁х画瑙傜湅">
          <div className="compact-list">
            {(watching.length ? watching : recent).map(({ movie, record }) => (
              <article key={movie.id}>
                <span className="poster small">{movie.poster}</span>
                <div>
                  <strong>{movie.title}</strong>
                  <p>{record?.status ?? "鏈敹钘?} 路 杩涘害 {record?.progress ?? 0}%</p>
                </div>
                <button onClick={() => props.updateRecord(movie.id, { status: "鍦ㄧ湅", progress: Math.max(record?.progress ?? 0, 10) })}>
                  缁х画
                </button>
              </article>
            ))}
          </div>
        </Panel>
      </section>

      <Panel title="鐗囧簱褰辩墖">
        <MovieGrid rows={props.rows.slice(0, 24)} updateRecord={props.updateRecord} />
      </Panel>
    </div>
  );
}

function LibraryView(props: {
  form: MovieForm;
  setForm: (form: MovieForm) => void;
  saveMovie: (event: FormEvent) => void;
  editingId: string | null;
  cancelEdit: () => void;
  rows: { movie: Movie; record?: UserMovieRecord }[];
  query: string;
  setQuery: (value: string) => void;
  statusFilter: MovieStatus | "鍏ㄩ儴";
  setStatusFilter: (value: MovieStatus | "鍏ㄩ儴") => void;
  updateRecord: (movieId: string, patch: Partial<UserMovieRecord>) => void;
  editMovie: (movie: Movie) => void;
  deleteMovie: (id: string) => void;
}) {
  return (
    <div className="page-stack">
      <PageHeader title="鎴戠殑鐗囧崟" description="鏂板褰辩墖锛岀淮鎶ゆ敹钘忕姸鎬併€佷紭鍏堢骇銆佽瘎浠峰拰鐗囧崟鍒嗙被銆? />
      <form className="editor" onSubmit={props.saveMovie}>
        <div className="form-grid">
          <Input label="鐗囧悕" value={props.form.title} onChange={(title) => props.setForm({ ...props.form, title })} required />
          <Input label="鑻辨枃鍚?鍒悕" value={props.form.alias} onChange={(alias) => props.setForm({ ...props.form, alias })} />
          <Input label="骞翠唤" value={props.form.year} onChange={(year) => props.setForm({ ...props.form, year })} />
          <label>
            鍐呭褰㈠紡
            <select value={props.form.type} onChange={(event) => props.setForm({ ...props.form, type: event.target.value as ContentType })}>
              {["鐢靛奖", "鍓ч泦", "鍔ㄦ极", "绾綍鐗?, "缁艰壓", "鐭墽"].map((item) => (
                <option key={item}>{item}</option>
              ))}
            </select>
          </label>
          <Input label="绫诲瀷" value={props.form.genres} onChange={(genres) => props.setForm({ ...props.form, genres })} />
          <Input label="鐗囬暱/鍗曢泦鍒嗛挓" value={props.form.durationMinutes} onChange={(durationMinutes) => props.setForm({ ...props.form, durationMinutes })} />
          <Input label="灏侀潰瀛? value={props.form.poster} onChange={(poster) => props.setForm({ ...props.form, poster })} />
          <Input label="骞冲彴" value={props.form.platforms} onChange={(platforms) => props.setForm({ ...props.form, platforms })} />
          <Input label="瀵兼紨" value={props.form.directors} onChange={(directors) => props.setForm({ ...props.form, directors })} />
          <Input label="婕斿憳" value={props.form.actors} onChange={(actors) => props.setForm({ ...props.form, actors })} />
          <label className="wide">
            绠€浠?            <textarea value={props.form.summary} onChange={(event) => props.setForm({ ...props.form, summary: event.target.value })} />
          </label>
        </div>
        <div className="actions">
          <button className="primary" type="submit">
            {props.editingId ? "淇濆瓨淇敼" : "鏂板褰辩墖"}
          </button>
          {props.editingId && <button type="button" onClick={props.cancelEdit}>鍙栨秷缂栬緫</button>}
        </div>
      </form>

      <section className="toolbar">
        <input placeholder="鎼滅储鐗囧悕銆佺被鍨嬨€佽嫳鏂囧悕" value={props.query} onChange={(event) => props.setQuery(event.target.value)} />
        <select value={props.statusFilter} onChange={(event) => props.setStatusFilter(event.target.value as MovieStatus | "鍏ㄩ儴")}>
          {["鍏ㄩ儴", "鎯崇湅", "鍦ㄧ湅", "宸茬湅", "鏆傚仠", "寮冪湅"].map((item) => (
            <option key={item}>{item}</option>
          ))}
        </select>
      </section>

      <MovieGrid
        rows={props.rows}
        updateRecord={props.updateRecord}
        editMovie={props.editMovie}
        deleteMovie={props.deleteMovie}
        detailed
      />
    </div>
  );
}

function PickerView(props: {
  picker: PickerInput;
  setPicker: (picker: PickerInput) => void;
  recommendations: ReturnType<typeof recommend>;
  skippedIds: string[];
  skipBatch: () => void;
  resetSkipped: () => void;
  updateRecord: (movieId: string, patch: Partial<UserMovieRecord>) => void;
  startWatchParty: (movie: Movie, startSeconds?: number) => void;
}) {
  return (
    <div className="page-stack">
      <PageHeader title="蹇€熼€夌墖" description="杈撳叆褰撲笅鏉′欢锛岃繑鍥?1 鍒?3 閮ㄥ€欓€夊奖鐗囷紝骞惰В閲婁负浠€涔堟帹鑽愩€? />
      <section className="picker-panel">
        <div className="segmented">
          {[30, 60, 120].map((minutes) => (
            <button
              className={props.picker.availableMinutes === minutes ? "selected" : ""}
              key={minutes}
              onClick={() => props.setPicker({ ...props.picker, availableMinutes: minutes })}
            >
              {minutes} 鍒嗛挓
            </button>
          ))}
        </div>
        <label>
          褰撳墠蹇冩儏
          <select value={props.picker.mood} onChange={(event) => props.setPicker({ ...props.picker, mood: event.target.value as Mood })}>
            {["杞绘澗", "鍒烘縺", "娌绘剤", "鐑ц剳"].map((item) => (
              <option key={item}>{item}</option>
            ))}
          </select>
        </label>
        <label>
          鍚岃浜?          <select value={props.picker.companion} onChange={(event) => props.setPicker({ ...props.picker, companion: event.target.value as Companion })}>
            {["鐙嚜", "鎯呬荆", "鏈嬪弸", "瀹跺涵"].map((item) => (
              <option key={item}>{item}</option>
            ))}
          </select>
        </label>
        <CheckboxGroup
          label="鍙敤骞冲彴"
          options={platformOptions}
          values={props.picker.platforms}
          onChange={(platforms) => props.setPicker({ ...props.picker, platforms })}
        />
        <CheckboxGroup
          label="鎯崇湅鐨勭被鍨?
          options={genreOptions}
          values={props.picker.genres}
          onChange={(genres) => props.setPicker({ ...props.picker, genres })}
        />
      </section>

      <section className="recommendations">
        <div className="section-title">
          <h2>鍊欓€夊奖鐗?/h2>
          <div className="actions">
            <button onClick={props.skipBatch}>鎹竴鎵?/button>
            {props.skippedIds.length > 0 && <button onClick={props.resetSkipped}>閲嶇疆璺宠繃</button>}
          </div>
        </div>
        {props.recommendations.length ? (
          props.recommendations.map(({ movie, record, score, reasons }) => (
            <article className="recommend-card" key={movie.id}>
              <span className="poster">{movie.poster}</span>
              <div>
                <div className="card-title">
                  <h3>{movie.title}</h3>
                  <span>{score} 鍖归厤鍒?/span>
                </div>
                <p>{movie.summary}</p>
                <div className="chips">
                  {movie.genres.map((genre) => <span className="chip" key={genre}>{genre}</span>)}
                  <span className="chip">{movie.durationMinutes} 鍒嗛挓</span>
                </div>
                <ul className="reason-list">
                  {reasons.map((reason) => <li key={reason}>{reason}</li>)}
                </ul>
                <div className="platforms">
                  {movie.platforms.length ? movie.platforms.map((platform) => (
                    <a href={playableUrl(platform, movie.title)} key={platform.platformName} rel="noreferrer" target="_blank">
                      {platform.platformName} 路 {platform.watchType}
                    </a>
                  )) : <span>鏆傛棤鐗囨簮锛屽彲璁剧疆鎻愰啋</span>}
                </div>
              </div>
              <button
                className="primary"
                onClick={() =>
                  props.updateRecord(movie.id, {
                    status: "鍦ㄧ湅",
                    progress: Math.max(record?.progress ?? 0, 10),
                    watchPlatform: movie.platforms[0]?.platformName ?? record?.watchPlatform ?? "",
                  })
                }
              >
                寮€濮嬭鐪?              </button>
              <button onClick={() => props.startWatchParty(movie)}>閭€璇峰叡鐪?/button>
            </article>
          ))
        ) : (
          <EmptyState text="娌℃湁瀹屽叏鍖归厤鐨勫奖鐗囥€傚缓璁斁瀹芥椂闂磋寖鍥淬€佸噺灏戠被鍨嬮檺鍒讹紝鎴栨墿澶у钩鍙拌寖鍥淬€? />
        )}
      </section>
    </div>
  );
}

function RankingsView(props: {
  ratingRank: ReturnType<typeof calcRatingRank>;
  heatRank: ReturnType<typeof calcSearchHeatRank>;
  costumeRank: ReturnType<typeof calcTagHeatRank>;
  urbanRank: ReturnType<typeof calcTagHeatRank>;
  shortDramaRank: ReturnType<typeof calcShortDramaRank>;
  yingjiRank: ReturnType<typeof calcYingjiRank>;
  categoryRanks: ReturnType<typeof calcCategoryRanks>;
  openMovie: (movie: Movie) => void;
}) {
  return (
    <div className="page-stack">
      <PageHeader
        title="鎺掕姒?
        description="鎸夎瘎鍒嗐€佹悳绱㈢儹搴︺€侀鏉愭爣绛惧拰褰辫抗鐢ㄦ埛璁板綍鐢熸垚姒滃崟锛岀偣鍑绘潯鐩嵆鍙煡鐪嬪奖鐗囧唴瀹广€?
      />
      <section className="ranking-feature">
        <RankList title="褰辫抗鎺掕姒? items={props.yingjiRank} valueSuffix="褰辫抗鍒? onSelect={props.openMovie} />
        <RankList title="鎼滅储鐑害姒? items={props.heatRank} valueSuffix="鐑害" onSelect={props.openMovie} />
      </section>
      <section className="ranking-grid">
        <RankList title="璇勫垎鎺掕姒? items={props.ratingRank} valueSuffix="鍒? onSelect={props.openMovie} />
        <RankList title="鍙よ鎺掕姒? items={props.costumeRank} valueSuffix="鐑害" onSelect={props.openMovie} />
        <RankList title="閮藉競鎺掕姒? items={props.urbanRank} valueSuffix="鐑害" onSelect={props.openMovie} />
        <RankList title="鐭墽鎺掕姒? items={props.shortDramaRank} valueSuffix="鐑害" onSelect={props.openMovie} />
      </section>
      <section className="category-ranks">
        <div className="section-title">
          <h2>鍏ㄧ綉鎼滅储褰辩墖鍒嗙被姒?/h2>
          <span>鎸夊奖鐗囨爣绛惧垎绫诲悗鍐嶈绠楃儹搴?/span>
        </div>
        <div className="ranking-grid">
          {props.categoryRanks.map((group) => (
            <RankList
              title={`${group.label}姒渀}
              items={group.items}
              valueSuffix="鐑害"
              key={group.label}
              onSelect={props.openMovie}
            />
          ))}
        </div>
      </section>
    </div>
  );
}

function SoloWatchView(props: {
  rows: { movie: Movie; record?: UserMovieRecord }[];
  row?: { movie: Movie; record?: UserMovieRecord };
  watchState: { movieId: string; positionSeconds: number; playing: boolean } | null;
  setWatchState: (state: { movieId: string; positionSeconds: number; playing: boolean } | null) => void;
  updateRecord: (movieId: string, patch: Partial<UserMovieRecord>) => void;
  startSoloWatch: (movie: Movie, startSeconds?: number) => void;
}) {
  if (!props.row || !props.watchState) {
    const candidates = props.rows
      .filter(({ record }) => (record?.progress ?? 0) > 0 || record?.status === "鍦ㄧ湅" || record?.status === "鎯崇湅")
      .slice(0, 12);
    return (
      <div className="page-stack">
        <PageHeader title="瑙傜湅" description="閫夋嫨涓€閮ㄥ奖鐗囩洿鎺ヨ鐪嬶紝杩涘害浼氫繚瀛樺埌浣犵殑鐗囧崟璁板綍銆? />
        {candidates.length ? (
          <section className="watch-pick-grid">
            {candidates.map(({ movie, record }) => {
              const progress = Math.max(record?.progress ?? 0, 0);
              const startSeconds = Math.floor(movie.durationMinutes * 60 * (progress / 100));
              return (
                <button className="watch-pick-card" key={movie.id} onClick={() => props.startSoloWatch(movie, startSeconds)}>
                  <span className="poster">{movie.poster}</span>
                  <div>
                    <strong>{movie.title}</strong>
                    <p>{movie.type} 路 {movie.year} 路 杩涘害 {progress}%</p>
                    <i><span style={{ width: `${progress}%` }} /></i>
                  </div>
                </button>
              );
            })}
          </section>
        ) : (
          <EmptyState text="鏆傛棤姝ｅ湪瑙傜湅鐨勫奖鐗囥€傚彲浠ュ厛鍘婚椤垫悳绱紝鎴栧湪鐗囧崟閲屾爣璁颁竴閮ㄥ奖鐗囦负鍦ㄧ湅銆? />
        )}
      </div>
    );
  }
  const { movie, record } = props.row;
  const maxSeconds = Math.max(movie.durationMinutes * 60, 60);
  const position = Math.min(maxSeconds, Math.max(0, props.watchState.positionSeconds));
  const progress = Math.round((position / maxSeconds) * 100);
  const primaryPlatform = movie.platforms[0];

  function updatePosition(positionSeconds: number, playing = props.watchState?.playing ?? false) {
    const safePosition = Math.min(maxSeconds, Math.max(0, positionSeconds));
    props.setWatchState({ movieId: movie.id, positionSeconds: safePosition, playing });
    props.updateRecord(movie.id, {
      status: safePosition >= maxSeconds ? "宸茬湅" : "鍦ㄧ湅",
      progress: Math.min(100, Math.round((safePosition / maxSeconds) * 100)),
      watchPlatform: movie.platforms[0]?.platformName ?? record?.watchPlatform ?? "",
    });
  }

  function openPrimaryPlatform() {
    updatePosition(position, true);
    openPlaybackResource(primaryPlatform, movie.title);
  }

  return (
    <div className="page-stack">
      <PageHeader title="鐩存帴瑙傜湅" description="浠庝笂娆¤繘搴︾户缁紝杩涘害浼氫繚瀛樺埌浣犵殑鐗囧崟璁板綍锛涘钩鍙板叆鍙ｅ湪鎾斁鍣ㄤ笅鏂广€? />
      <section className="solo-player">
        <div className="solo-screen">
          <span>{movie.poster}</span>
          <button className="screen-play-button" onClick={openPrimaryPlatform} disabled={!primaryPlatform} aria-label="鎵撳紑骞冲彴瑙傜湅">
            鈻?          </button>
          <strong>{movie.title}</strong>
          <p>{props.watchState.playing ? "鎾斁涓? : "宸叉殏鍋?} 路 {secondsLabel(position)} / {secondsLabel(maxSeconds)}</p>
          {!primaryPlatform && <p className="resource-empty">鏆傛椂鏃犳硶鎵惧埌褰辫璧勬簮</p>}
        </div>
        <div className="solo-controls">
          <input
            aria-label="瑙傜湅杩涘害"
            type="range"
            min="0"
            max={maxSeconds}
            value={position}
            onChange={(event) => updatePosition(Number(event.target.value))}
          />
          <div className="actions">
            <button className="primary" onClick={openPrimaryPlatform} disabled={!primaryPlatform}>
              {primaryPlatform ? `鎵撳紑${primaryPlatform.platformName}鎾斁鍏ュ彛` : "鏆傛棤鎾斁鍏ュ彛"}
            </button>
            <button onClick={() => updatePosition(position, false)}>鏆傚仠</button>
            <button onClick={() => updatePosition(position - 30)}>鍚庨€€ 30 绉?/button>
            <button onClick={() => updatePosition(position + 30, true)}>鍓嶈繘 30 绉?/button>
            <button onClick={() => updatePosition(maxSeconds, false)}>鏍囪鐪嬪畬</button>
          </div>
          <p>褰撳墠杩涘害 {progress}%</p>
          <p className="notice">杩欓噷璐熻矗璁板綍鍜屾仮澶嶈繘搴︺€傜偣鍑绘挱鏀句細鎵撳紑璇ュ奖鐗囧湪骞冲彴閲岀殑鎼滅储/鎾斁鍏ュ彛锛屽疄闄呮挱鏀剧敱瀵瑰簲骞冲彴瀹屾垚銆?/p>
          <div className="platform-tags">
            {movie.platforms.length ? movie.platforms.map((platform) => (
              <a href={playableUrl(platform, movie.title)} key={platform.platformName} rel="noreferrer" target="_blank">
                鎵撳紑 {platform.platformName}
              </a>
            )) : <span>鏆傛椂鏃犳硶鎵惧埌褰辫璧勬簮</span>}
          </div>
        </div>
      </section>
    </div>
  );
}

function WatchPartyView(props: {
  movies: Movie[];
  draft: WatchRoomDraft;
  setDraft: (draft: WatchRoomDraft) => void;
  room: WatchRoom | null;
  chatInput: string;
  setChatInput: (value: string) => void;
  createRoom: () => void;
  sendMessage: (event: FormEvent) => void;
  updatePlayback: (patch: Partial<PlaybackState>, updatedBy?: string) => void;
}) {
  const [movieSearch, setMovieSearch] = useState("");
  const selectedMovie = props.movies.find((movie) => movie.id === props.draft.movieId) ?? props.movies[0];
  const movieOptions = useMemo(() => {
    const keyword = movieSearch.trim().toLowerCase();
    if (!keyword) return props.movies.slice(0, 80);
    return props.movies
      .filter((movie) => [
        movie.title,
        movie.alias,
        movie.type,
        movie.genres.join(" "),
        movie.actors.join(" "),
        movie.platforms.map((platform) => platform.platformName).join(" "),
      ].join(" ").toLowerCase().includes(keyword))
      .slice(0, 80);
  }, [movieSearch, props.movies]);
  useEffect(() => {
    if (!movieSearch.trim() || !movieOptions.length) return;
    if (movieOptions.some((movie) => movie.id === props.draft.movieId)) return;
    changeMovie(movieOptions[0].id);
  }, [movieOptions, movieSearch, props.draft.movieId]);
  const roomMovie = props.movies.find((movie) => movie.id === props.room?.movieId) ?? selectedMovie;
  const selectedPlatform =
    roomMovie?.platforms.find((platform) => platform.platformName === props.room?.platformName) ??
    selectedMovie?.platforms.find((platform) => platform.platformName === props.draft.platformName) ??
    selectedMovie?.platforms[0];
  const embeddedPlaybackUrl = selectedPlatform ? playableUrl(selectedPlatform, roomMovie?.title ?? selectedMovie?.title ?? "") : "";
  const hostName = props.draft.hostName.trim() || "鎴?;
  const friendName = props.draft.friendName.trim() || "濂藉弸";

  function copyInviteLink() {
    if (!props.room) return;
    void navigator.clipboard?.writeText(props.room.inviteLink);
  }

  function changeMovie(movieId: string) {
    const nextMovie = props.movies.find((movie) => movie.id === movieId);
    props.setDraft({
      ...props.draft,
      movieId,
      platformName: nextMovie?.platforms[0]?.platformName ?? props.draft.platformName,
    });
  }

  function playOnPlatform() {
    if (!props.room) return;
    if (!selectedPlatform) {
      window.alert("鏆傛椂鏃犳硶鎵惧埌褰辫璧勬簮");
      return;
    }
    props.updatePlayback({ status: "鎾斁涓? });
  }

  function openChatPopup() {
    if (!props.room) return null;
    const url = `/chat.html?room=${encodeURIComponent(props.room.id)}&author=${encodeURIComponent(hostName)}`;
    return window.open(url, `cinelist-chat-${props.room.id}`, "width=390,height=620,resizable=yes,scrollbars=yes");
  }

  return (
    <div className="page-stack">
      <PageHeader
        title="涓€璧风湅"
        description="鍒涘缓涓€涓叡鐪嬫埧闂达紝鎶婂奖鐗囥€佸钩鍙板叆鍙ｃ€佽亰澶╁拰鎾斁鍚屾鎸囦护鏀惧湪鍚屼竴涓晫闈㈤噷銆?
      />

      <section className="watch-hero">
        <div>
          <p className="eyebrow">Watch Party MVP</p>
          <h1>鍏变韩鐨勬槸瑙傚奖鑺傚锛屼笉鎼繍浼氬憳鐗囨簮銆?/h1>
          <p>
            杩欎釜椤甸潰璐熻矗閭€璇枫€佽亰澶╁拰鍚屾鎾斁鎰忓浘銆傛寮忓浜哄疄鏃跺悓姝ラ渶瑕佸悗绔?WebSocket锛涚涓夋柟浼氬憳鍐呭浠嶇敱鍚勮嚜璐﹀彿鍦ㄥ搴斿钩鍙板悎娉曟挱鏀俱€?          </p>
        </div>
        <div className="watch-status">
          <span>{props.room ? "鎴块棿宸插垱寤? : "绛夊緟鍒涘缓鎴块棿"}</span>
          <strong>{props.room?.id.replace("room-", "#") ?? "Ready"}</strong>
        </div>
      </section>

      <section className="watch-layout">
        <Panel title="鍒涘缓閭€璇?>
          <div className="form-grid">
            <label>
              鎼滅储褰辩墖
              <input
                placeholder="杈撳叆鐗囧悕銆佺被鍨嬨€佸钩鍙?
                value={movieSearch}
                onChange={(event) => setMovieSearch(event.target.value)}
              />
            </label>
            <label>
              閫夋嫨褰辩墖
              <select value={props.draft.movieId} onChange={(event) => changeMovie(event.target.value)}>
                {movieOptions.map((movie) => (
                  <option value={movie.id} key={movie.id}>{movie.title}</option>
                ))}
              </select>
            </label>
            <label>
              瑙傜湅骞冲彴
              <select
                value={props.draft.platformName}
                onChange={(event) => props.setDraft({ ...props.draft, platformName: event.target.value })}
              >
                {(selectedMovie?.platforms.length ? selectedMovie.platforms : platformOptions.map((platformName) => makePlatform(platformName, selectedMovie?.title ?? ""))).map((platform) => (
                  <option value={platform.platformName} key={platform.platformName}>{platform.platformName}</option>
                ))}
              </select>
            </label>
            <Input label="鎴戠殑鏄电О" value={props.draft.hostName} onChange={(hostName) => props.setDraft({ ...props.draft, hostName })} />
            <Input label="濂藉弸鏄电О" value={props.draft.friendName} onChange={(friendName) => props.setDraft({ ...props.draft, friendName })} />
          </div>
          <div className="actions">
            <button className="primary" onClick={props.createRoom}>鍒涘缓鍏辩湅鎴块棿</button>
            {selectedPlatform && (
              <a className="button-link" href={playableUrl(selectedPlatform, selectedMovie?.title ?? "")} rel="noreferrer" target="_blank">
                鎵撳紑骞冲彴
              </a>
            )}
          </div>

          {props.room && (
            <div className="invite-box">
              <span>閭€璇烽摼鎺?/span>
              <code>{props.room.inviteLink}</code>
              <button onClick={copyInviteLink}>澶嶅埗閾炬帴</button>
            </div>
          )}
        </Panel>

        <Panel title="鎴块棿鎴愬憳">
          <div className="room-movie">
            <span className="poster">{roomMovie?.poster ?? "褰?}</span>
            <div>
              <h3>{roomMovie?.title ?? "璇烽€夋嫨褰辩墖"}</h3>
              <p>{roomMovie?.alias} 路 {props.room?.platformName ?? props.draft.platformName}</p>
            </div>
          </div>
          <div className="member-list">
            {(props.room?.members ?? [hostName, friendName]).map((member) => (
              <span className="chip strong" key={member}>{member}</span>
            ))}
          </div>
          <p className="notice">
            鐜板湪鏄墠绔師鍨嬶細鍚屼竴娴忚鍣ㄥ唴鍙綋楠屾祦绋嬨€傛寮忎笂绾挎椂锛屾埧闂寸姸鎬併€佹秷鎭拰鎾斁鎸囦护浼氶€氳繃 WebSocket 骞挎挱缁欓摼鎺ラ噷鐨勬瘡涓垚鍛樸€?          </p>
        </Panel>
      </section>

      <section className="watch-party-shell">
        <aside className="watch-chat-pane">
          <div className="section-title">
            <span>当前房间聊天</span>
            <button disabled={!props.room} onClick={openChatPopup}>弹出小窗</button>
          </div>
          <div className="watch-chat-scroll">
            {(props.room?.messages ?? []).map((message) => (
              <article className={message.author === "系统" ? "system-message" : ""} key={message.id}>
                <strong>{message.author}</strong>
                <p>{message.text}</p>
                <span>{timeLabel(message.createdAt)}</span>
              </article>
            ))}
            {!props.room && <EmptyState text="创建房间后即可开始聊天。" />}
          </div>
          <form className="chat-form shell-chat-form" onSubmit={props.sendMessage}>
            <input
              aria-label="聊天内容"
              disabled={!props.room}
              placeholder="边看边聊，吐槽也有进度条"
              value={props.chatInput}
              onChange={(event) => props.setChatInput(event.target.value)}
            />
            <button className="primary" disabled={!props.room} type="submit">发送</button>
          </form>
        </aside>

        <section className="watch-video-pane">
          <div className="video-frame">
            {selectedPlatform ? (
              <iframe
                key={embeddedPlaybackUrl}
                src={embeddedPlaybackUrl}
                title={`${roomMovie?.title ?? selectedMovie?.title ?? "影迹"} 播放窗口`}
                referrerPolicy="no-referrer-when-downgrade"
                allow="autoplay; fullscreen; picture-in-picture"
                allowFullScreen
              />
            ) : (
              <div className="video-empty">
                <span>{roomMovie?.poster ?? "影"}</span>
                <p>暂时无法找到影视资源</p>
              </div>
            )}
          </div>
          <div className="video-control-bar">
            <div>
              <strong>{roomMovie?.title ?? "未选择影片"}</strong>
              <p>
                {props.room?.playback.status ?? "已暂停"} · {secondsLabel(props.room?.playback.positionSeconds ?? 0)} ·
                {props.room?.playback.playbackRate ?? 1}x
              </p>
            </div>
            <a
              className={selectedPlatform ? "button-link primary" : "button-link disabled"}
              href={selectedPlatform ? embeddedPlaybackUrl : undefined}
              rel="noreferrer"
              target="_blank"
            >
              在新标签打开播放
            </a>
          </div>
          <input
            aria-label="同步进度"
            type="range"
            min="0"
            max={Math.max((roomMovie?.durationMinutes ?? 90) * 60, 60)}
            value={props.room?.playback.positionSeconds ?? 0}
            onChange={(event) => props.updatePlayback({ positionSeconds: Number(event.target.value) })}
            disabled={!props.room}
          />
          <div className="actions">
            <button disabled={!props.room || !selectedPlatform} onClick={playOnPlatform}>播放</button>
            <button disabled={!props.room} onClick={() => props.updatePlayback({ status: "已暂停" })}>暂停</button>
            <button disabled={!props.room} onClick={() => props.updatePlayback({ positionSeconds: Math.max((props.room?.playback.positionSeconds ?? 0) - 30, 0) })}>
              后退 30 秒
            </button>
            <button disabled={!props.room} onClick={() => props.updatePlayback({ positionSeconds: (props.room?.playback.positionSeconds ?? 0) + 30 })}>
              前进 30 秒
            </button>
          </div>
          <div className="segmented compact">
            {[0.75, 1, 1.25, 1.5].map((rate) => (
              <button
                disabled={!props.room}
                className={props.room?.playback.playbackRate === rate ? "selected" : ""}
                key={rate}
                onClick={() => props.updatePlayback({ playbackRate: rate })}
              >
                {rate}x
              </button>
            ))}
          </div>
          <p className="sync-meta">
            最近同步：{props.room ? `${props.room.playback.updatedBy} · ${timeLabel(props.room.playback.updatedAt)}` : "创建房间后可用"}
          </p>
          <p className="notice">如果右侧视频网站拒绝内嵌播放，请点击“在新标签打开播放”，左侧聊天仍会留在本页。</p>
        </section>
      </section>

      <section className="watch-layout">
        <Panel title="鍚屾鎺у埗">
          <div className="sync-stage" aria-label="鍏辩湅鍚屾棰勮">
            <div className="screen-glow">
              <span>{roomMovie?.poster ?? "褰?}</span>
              <button className="screen-play-button" disabled={!props.room || !selectedPlatform} onClick={playOnPlatform} aria-label="鎾斁骞跺脊鍑鸿亰澶╃獥">
                鈻?              </button>
            </div>
            <div>
              <strong>{roomMovie?.title ?? "鏈€夋嫨褰辩墖"}</strong>
              <p>
                {props.room?.playback.status ?? "宸叉殏鍋?} 路 {secondsLabel(props.room?.playback.positionSeconds ?? 0)} 路
                {props.room?.playback.playbackRate ?? 1}x
              </p>
              {!selectedPlatform && <p className="resource-empty">鏆傛椂鏃犳硶鎵惧埌褰辫璧勬簮</p>}
            </div>
          </div>
          <input
            aria-label="鍚屾杩涘害"
            type="range"
            min="0"
            max={Math.max((roomMovie?.durationMinutes ?? 90) * 60, 60)}
            value={props.room?.playback.positionSeconds ?? 0}
            onChange={(event) => props.updatePlayback({ positionSeconds: Number(event.target.value) })}
            disabled={!props.room}
          />
          <div className="actions">
            <button disabled={!props.room || !selectedPlatform} onClick={playOnPlatform}>
              {selectedPlatform ? `鎾斁骞跺脊鍑鸿亰澶╃獥` : "鏆傛棤鎾斁鍏ュ彛"}
            </button>
            <button disabled={!props.room} onClick={() => props.updatePlayback({ status: "宸叉殏鍋? })}>鏆傚仠</button>
            <button disabled={!props.room} onClick={() => props.updatePlayback({ positionSeconds: Math.max((props.room?.playback.positionSeconds ?? 0) - 30, 0) })}>
              鍚庨€€ 30 绉?            </button>
            <button disabled={!props.room} onClick={() => props.updatePlayback({ positionSeconds: (props.room?.playback.positionSeconds ?? 0) + 30 })}>
              鍓嶈繘 30 绉?            </button>
          </div>
          <div className="segmented compact">
            {[0.75, 1, 1.25, 1.5].map((rate) => (
              <button
                disabled={!props.room}
                className={props.room?.playback.playbackRate === rate ? "selected" : ""}
                key={rate}
                onClick={() => props.updatePlayback({ playbackRate: rate })}
              >
                {rate}x
              </button>
            ))}
          </div>
          <p className="sync-meta">
            鏈€杩戝悓姝ワ細{props.room ? `${props.room.playback.updatedBy} 路 ${timeLabel(props.room.playback.updatedAt)}` : "鍒涘缓鎴块棿鍚庡彲鐢?}
          </p>
          <p className="notice">鎾斁浼氬悓鏃跺脊鍑哄奖杩硅亰澶╁皬绐楋紝骞跺湪鏂版爣绛炬墦寮€骞冲彴鍏ュ彛锛涘鏋滄祻瑙堝櫒鎷︽埅寮圭獥锛岃鍏佽鏈珯寮圭獥銆?/p>
        </Panel>

        <Panel title="鑱婂ぉ浜掑姩">
          <div className="section-title">
            <span>褰撳墠鎴块棿鑱婂ぉ</span>
            <button className="primary" disabled={!props.room} onClick={openChatPopup}>寮瑰嚭鑱婂ぉ绐?/button>
          </div>
          <div className="chat-list">
            {(props.room?.messages ?? []).map((message) => (
              <article className={message.author === "绯荤粺" ? "system-message" : ""} key={message.id}>
                <strong>{message.author}</strong>
                <p>{message.text}</p>
                <span>{timeLabel(message.createdAt)}</span>
              </article>
            ))}
            {!props.room && <EmptyState text="鍒涘缓鎴块棿鍚庡嵆鍙紑濮嬭亰澶┿€? />}
          </div>
          <form className="chat-form" onSubmit={props.sendMessage}>
            <input
              aria-label="鑱婂ぉ鍐呭"
              disabled={!props.room}
              placeholder="杈圭湅杈硅亰锛屽悙妲戒篃鏈夎繘搴︽潯"
              value={props.chatInput}
              onChange={(event) => props.setChatInput(event.target.value)}
            />
            <button className="primary" disabled={!props.room} type="submit">鍙戦€?/button>
          </form>
        </Panel>
      </section>

      <section className="implementation-note">
        <h2>姝ｅ紡瀹炵幇蹇呰鏉′欢</h2>
        <div className="note-grid">
          <span>WebSocket 鎴块棿鏈嶅姟</span>
          <span>鎴块棿涓庢秷鎭暟鎹簱</span>
          <span>娓稿鎴栬处鍙疯韩浠?/span>
          <span>骞冲彴鍚堟硶鎾斁鍏ュ彛</span>
          <span>鎾斁鎸囦护鍐茬獊澶勭悊</span>
          <span>閭€璇烽摼鎺ユ潈闄愭帶鍒?/span>
        </div>
      </section>
    </div>
  );
}

function DiscussionView(props: {
  movies: Movie[];
  records: Record<string, UserMovieRecord>;
  discussions: Record<string, DiscussionComment[]>;
  loadDiscussions: (movieId: string) => void | Promise<void>;
  addComment: (movieId: string, text: string, parentId: string | null) => void;
  toggleLike: (movieId: string, commentId: string) => void;
  goHome: () => void;
  startSoloWatch: (movie: Movie, startSeconds?: number) => void;
  startWatchParty: (movie: Movie, startSeconds?: number) => void;
}) {
  const [selectedMovieId, setSelectedMovieId] = useState(props.movies[0]?.id ?? "");
  const [movieSearch, setMovieSearch] = useState("");
  const [draft, setDraft] = useState("");
  const [replyDrafts, setReplyDrafts] = useState<Record<string, string>>({});
  const selectedMovie = props.movies.find((movie) => movie.id === selectedMovieId) ?? props.movies[0];
  const movieSearchTerm = movieSearch.trim().toLowerCase();
  const searchedMovies = movieSearchTerm
    ? props.movies.filter((movie) => {
        const searchable = [
          movie.title,
          movie.alias,
          movie.type,
          movie.year.toString(),
          movie.genres.join(" "),
          movie.platforms.map((platform) => platform.platformName).join(" "),
        ].join(" ").toLowerCase();
        return searchable.includes(movieSearchTerm);
      })
    : [];
  const comments = selectedMovie ? props.discussions[selectedMovie.id] ?? [] : [];
  const rootComments = comments
    .filter((comment) => !comment.parentId)
    .sort((a, b) => b.likes - a.likes || new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());
  const repliesByParent = comments.reduce<Record<string, DiscussionComment[]>>((groups, comment) => {
    if (!comment.parentId) return groups;
    groups[comment.parentId] = [...(groups[comment.parentId] ?? []), comment].sort(
      (a, b) => b.likes - a.likes || new Date(a.createdAt).getTime() - new Date(b.createdAt).getTime(),
    );
    return groups;
  }, {});

  useEffect(() => {
    if (!selectedMovie?.id) return;
    void props.loadDiscussions(selectedMovie.id);
  }, [selectedMovie?.id]);

  async function submitComment(event: FormEvent) {
    event.preventDefault();
    if (!selectedMovie) return;
    await props.addComment(selectedMovie.id, draft, null);
    await props.loadDiscussions(selectedMovie.id);
    setDraft("");
  }

  async function submitReply(event: FormEvent, parentId: string) {
    event.preventDefault();
    if (!selectedMovie) return;
    await props.addComment(selectedMovie.id, replyDrafts[parentId] ?? "", parentId);
    await props.loadDiscussions(selectedMovie.id);
    setReplyDrafts((current) => ({ ...current, [parentId]: "" }));
  }

  if (!selectedMovie) return <EmptyState text="鏆傛棤褰辩墖锛屽厛鍘绘垜鐨勭墖鍗曟柊澧炰竴閮ㄥ惂銆? />;

  return (
    <div className="page-stack">
      <div className="page-header-actions">
        <PageHeader title="璁ㄨ鍖? description="鍏堢湅褰辩墖鍐呭锛屽啀杩涘叆璁ㄨ鏍戞礊銆傛父瀹㈠拰鐧诲綍鐢ㄦ埛閮藉彲浠ヨ瘎璁恒€佺偣璧炲拰鍥炲銆? />
        <button type="button" onClick={props.goHome}>杩斿洖褰辫抗涓婚〉</button>
      </div>
      <section className="discussion-layout">
        <Panel title="褰辩墖鍐呭">
          <label>
            鎼滅储褰辩墖
            <input
              placeholder="杈撳叆鐗囧悕銆佺被鍨嬨€佸勾浠芥垨骞冲彴"
              value={movieSearch}
              onChange={(event) => setMovieSearch(event.target.value)}
            />
          </label>
          {movieSearchTerm && (
            <div className="discussion-search-results">
              {searchedMovies.length ? searchedMovies.map((movie) => (
                <button
                  className={movie.id === selectedMovie.id ? "active" : ""}
                  key={movie.id}
                  onClick={() => setSelectedMovieId(movie.id)}
                  type="button"
                >
                  {movie.title}
                  <span>{movie.type} 路 {movie.year}</span>
                </button>
              )) : <span>娌℃湁鎵惧埌鍖归厤褰辩墖</span>}
            </div>
          )}
          <label>
            閫夋嫨褰辩墖
            <select value={selectedMovie.id} onChange={(event) => setSelectedMovieId(event.target.value)}>
              {props.movies.map((movie) => (
                <option value={movie.id} key={movie.id}>{movie.title}</option>
              ))}
            </select>
          </label>
          <article className="discussion-movie">
            <span className="poster">{selectedMovie.poster}</span>
            <div>
              <p className="eyebrow">{selectedMovie.type} 路 {selectedMovie.year}</p>
              <h2>{selectedMovie.title}</h2>
              <p>{selectedMovie.alias || "鏆傛棤鍒悕"} 路 {selectedMovie.durationMinutes} 鍒嗛挓 路 {props.records[selectedMovie.id]?.status ?? "鏈敹钘?}</p>
              <p>{selectedMovie.summary || "鏆傛棤绠€浠?}</p>
              <div className="chips">
                {selectedMovie.genres.map((genre) => <span className="chip strong" key={genre}>{genre}</span>)}
              </div>
            </div>
          </article>
          <div className="platform-tags">
            {selectedMovie.platforms.length ? selectedMovie.platforms.map((platform) => (
              <a href={playableUrl(platform, selectedMovie.title)} key={platform.platformName} rel="noreferrer" target="_blank">
                {platform.platformName} 路 {platform.watchType}
              </a>
            )) : <span>鏆傛椂鏃犳硶鎵惧埌褰辫璧勬簮</span>}
          </div>
          <div className="actions">
            <button onClick={() => props.startSoloWatch(selectedMovie)}>鐩存帴瑙傜湅</button>
            <button className="primary" onClick={() => props.startWatchParty(selectedMovie)}>涓€璧风湅</button>
          </div>
        </Panel>

        <Panel title="璁ㄨ鏍戞礊">
          <form className="discussion-form" onSubmit={submitComment}>
            <textarea
              aria-label="鍙戝竷璇勮"
              placeholder="鍐欎笅浣犵殑鎰熷彈銆佺枒闂€佸悙妲芥垨鎺ㄨ崘鐞嗙敱"
              value={draft}
              onChange={(event) => setDraft(event.target.value)}
            />
            <button className="primary" type="submit">鍙戝竷璇勮</button>
          </form>
          <div className="discussion-list">
            {rootComments.length ? rootComments.map((comment) => (
              <article className="comment-card" key={comment.id}>
                <CommentBody comment={comment} movieId={selectedMovie.id} toggleLike={props.toggleLike} />
                <form className="reply-form" onSubmit={(event) => submitReply(event, comment.id)}>
                  <input
                    aria-label="鍥炲璇勮"
                    placeholder="鍥炲杩欐潯璇勮"
                    value={replyDrafts[comment.id] ?? ""}
                    onChange={(event) => setReplyDrafts((current) => ({ ...current, [comment.id]: event.target.value }))}
                  />
                  <button type="submit">鍥炲</button>
                </form>
                {!!repliesByParent[comment.id]?.length && (
                  <div className="reply-list">
                    {repliesByParent[comment.id].map((reply) => (
                      <article className="comment-card reply" key={reply.id}>
                        <CommentBody comment={reply} movieId={selectedMovie.id} toggleLike={props.toggleLike} />
                      </article>
                    ))}
                  </div>
                )}
              </article>
            )) : <EmptyState text="杩樻病鏈夎瘎璁恒€傛潵褰撶涓€涓捇杩涙爲娲炵殑浜恒€? />}
          </div>
        </Panel>
      </section>
    </div>
  );
}

function CommentBody(props: {
  comment: DiscussionComment;
  movieId: string;
  toggleLike: (movieId: string, commentId: string) => void;
}) {
  return (
    <>
      <div className="comment-head">
        <strong>{props.comment.author}</strong>
        <span>{timeLabel(props.comment.createdAt)}</span>
      </div>
      <p>{props.comment.text}</p>
      <button
        className={props.comment.likedByMe ? "like-button active" : "like-button"}
        onClick={() => props.toggleLike(props.movieId, props.comment.id)}
      >
        馃憤 {props.comment.likes}
      </button>
    </>
  );
}

function SummaryView(props: {
  rows: { movie: Movie; record?: UserMovieRecord }[];
  summary: ReturnType<typeof calcSummary>;
  genreScores: { genre: string; score: number }[];
}) {
  return (
    <div className="page-stack">
      <PageHeader title="涓汉鎬荤粨" description="浠庣湡瀹炶褰辫褰曚腑缁熻鏁伴噺銆佹椂闀裤€佸亸濂藉拰浠ｈ〃浣滃搧銆? />
      <section className="metric-grid">
        <Metric label="宸茬湅鏁伴噺" value={props.summary.watchedCount} />
        <Metric label="瑙傜湅鏃堕暱" value={`${props.summary.totalMinutes} 鍒嗛挓`} />
        <Metric label="骞冲潎璇勫垎" value={props.summary.averageRating || "鏆傛棤"} />
        <Metric label="浜屽埛/閲嶇湅" value={props.summary.rewatchCount} />
      </section>
      <section className="split">
        <Panel title="绫诲瀷鍋忓ソ">
          <BarList items={props.genreScores.slice(0, 8).map((item) => ({ label: item.genre, value: item.score }))} />
        </Panel>
        <Panel title="骞冲彴鍒嗗竷">
          <BarList items={Object.entries(props.summary.platformMap).map(([label, value]) => ({ label, value }))} />
        </Panel>
      </section>
      <Panel title="浠ｈ〃浣滃搧">
        <MovieGrid rows={props.rows.filter(({ record }) => normalizeRating(record?.rating ?? 0) >= 4).slice(0, 6)} updateRecord={() => undefined} />
      </Panel>
    </div>
  );
}

function SettingsView(props: {
  profile: UserProfile;
  setProfile: (profile: UserProfile) => void;
  resetData: () => void;
  toggleArrayField: <T extends string>(value: T, current: T[], update: (next: T[]) => void) => void;
}) {
  const senior = props.profile.privacySettings.useAge && isSenior(props.profile.ageRange);
  return (
    <div className="page-stack">
      <PageHeader title="璁剧疆" description="绠＄悊鐢ㄦ埛鐢诲儚銆佸父鐢ㄥ钩鍙般€侀殣绉佹帶鍒跺拰瀛楀箷杈呭姪銆? />
      <section className="settings-grid">
        <Panel title="鐢ㄦ埛鐢诲儚">
          <label>
            骞撮緞娈?            <select value={props.profile.ageRange} onChange={(event) => props.setProfile({ ...props.profile, ageRange: event.target.value, manualSubtitle: false })}>
              {["涓嶆効閫忛湶", "18浠ヤ笅", "18-25", "26-35", "36-45", "46-54", "55-64", "65浠ヤ笂"].map((item) => <option key={item}>{item}</option>)}
            </select>
          </label>
          <label>
            鎬у埆
            <select value={props.profile.gender} onChange={(event) => props.setProfile({ ...props.profile, gender: event.target.value })}>
              {["涓嶄究閫忛湶", "鐢?, "濂?, "闈炰簩鍏?, "鑷畾涔?].map((item) => <option key={item}>{item}</option>)}
            </select>
          </label>
          <Input label="鍦板尯" value={props.profile.region} onChange={(region) => props.setProfile({ ...props.profile, region })} />
        </Panel>
        <Panel title="鎺ㄨ崘鎺у埗">
          <CheckboxGroup
            label="鍠滄绫诲瀷"
            options={genreOptions}
            values={props.profile.favoriteGenres}
            onChange={(favoriteGenres) => props.setProfile({ ...props.profile, favoriteGenres })}
          />
          <CheckboxGroup
            label="甯哥敤骞冲彴"
            options={platformOptions}
            values={props.profile.commonPlatforms}
            onChange={(commonPlatforms) => props.setProfile({ ...props.profile, commonPlatforms })}
          />
          <label className="toggle-row">
            <input
              type="checkbox"
              checked={props.profile.privacySettings.useAge}
              onChange={(event) => props.setProfile({ ...props.profile, privacySettings: { ...props.profile.privacySettings, useAge: event.target.checked } })}
            />
            鍏佽骞撮緞娈靛弬涓庡喎鍚姩鎺ㄨ崘
          </label>
          <label className="toggle-row">
            <input
              type="checkbox"
              checked={props.profile.privacySettings.useGender}
              onChange={(event) => props.setProfile({ ...props.profile, privacySettings: { ...props.profile.privacySettings, useGender: event.target.checked } })}
            />
            鍏佽鎬у埆鍙備笌鍐峰惎鍔ㄦ帹鑽?          </label>
        </Panel>
        <Panel title="瀛楀箷杈呭姪">
          {senior && <p className="notice">宸茶瘑鍒负 55 宀佷互涓婂勾榫勬锛岄娆℃挱鏀鹃粯璁ゅ缓璁?130% 澶у彿瀛楀箷銆?/p>}
          <label>
            瀛楀箷瀛楀彿锛歿props.profile.subtitleScale}%
            <input
              type="range"
              min="80"
              max="200"
              step="10"
              value={props.profile.subtitleScale}
              onChange={(event) => props.setProfile({ ...props.profile, subtitleScale: Number(event.target.value), manualSubtitle: true })}
            />
          </label>
          <div className="subtitle-preview" style={{ fontSize: `${props.profile.subtitleScale / 100}rem` }}>
            杩欐槸涓€娈靛瓧骞曢瑙堬紝鐢ㄦ埛鎵嬪姩璁剧疆鍚庝笉浼氳骞撮緞瑙勫垯瑕嗙洊銆?          </div>
        </Panel>
        <Panel title="鏁版嵁绠＄悊">
          <p>鐧诲綍鍚庢暟鎹細鍚屾淇濆瓨鍒拌处鍙凤紱娴忚鍣ㄦ湰鍦颁粛淇濈暀涓€浠界紦瀛橈紝渚夸簬棣栨瀵煎叆鍜屽埛鏂版仮澶嶃€?/p>
          <button className="danger" onClick={props.resetData}>鎭㈠绀轰緥鏁版嵁</button>
        </Panel>
      </section>
    </div>
  );
}

function MovieGrid(props: {
  rows: { movie: Movie; record?: UserMovieRecord }[];
  updateRecord: (movieId: string, patch: Partial<UserMovieRecord>) => void;
  editMovie?: (movie: Movie) => void;
  deleteMovie?: (id: string) => void;
  detailed?: boolean;
}) {
  if (!props.rows.length) return <EmptyState text="鏆傛棤褰辩墖锛屽厛鏂板涓€閮ㄥ惂銆? />;
  return (
    <div className="movie-grid">
      {props.rows.map(({ movie, record }) => (
        <article className="movie-card" key={movie.id}>
          <div className="movie-top">
            <span className="poster">{movie.poster}</span>
            <div>
              <h3>{movie.title}</h3>
              <p>{movie.alias || movie.type} 路 {movie.year} 路 {movie.durationMinutes} 鍒嗛挓</p>
            </div>
          </div>
          <p>{movie.summary || "鏆傛棤绠€浠?}</p>
          <div className="chips">
            {movie.genres.map((genre) => <span className="chip" key={genre}>{genre}</span>)}
          </div>
          <div className="platforms">
            {movie.platforms.length
              ? movie.platforms.map((platform) => (
                  <a href={playableUrl(platform, movie.title)} key={platform.platformName} rel="noreferrer" target="_blank">
                    {platform.platformName} 路 {platform.watchType} 路 {platform.lastCheckedAt}
                  </a>
                ))
              : <span>鏆傛棤鐗囨簮锛屽彲璁剧疆鎻愰啋</span>}
          </div>
          <div className="record-grid">
            <label>
              鐘舵€?              <select value={record?.status ?? "鎯崇湅"} onChange={(event) => props.updateRecord(movie.id, { status: event.target.value as MovieStatus })}>
                {["鎯崇湅", "鍦ㄧ湅", "宸茬湅", "鏆傚仠", "寮冪湅"].map((item) => <option key={item}>{item}</option>)}
              </select>
            </label>
            <label>
              浼樺厛绾?              <select value={record?.priority ?? "鏈夋椂闂寸湅"} onChange={(event) => props.updateRecord(movie.id, { priority: event.target.value as Priority })}>
                {["寰堟兂鐪?, "鏈夋椂闂寸湅", "闅忕紭鐪?].map((item) => <option key={item}>{item}</option>)}
              </select>
            </label>
            {props.detailed && (
              <>
                <label>
                  鐪嬪畬璇勫垎
                  <RatingControl
                    value={normalizeRating(record?.rating ?? 0)}
                    onChange={(rating) => props.updateRecord(movie.id, { rating, status: rating > 0 ? "宸茬湅" : record?.status })}
                  />
                </label>
                <label>
                  杩涘害
                  <input
                    type="number"
                    min="0"
                    max="100"
                    value={record?.progress ?? 0}
                    onChange={(event) => props.updateRecord(movie.id, { progress: Number(event.target.value) })}
                  />
                </label>
                <label>
                  瑙傜湅鏃ユ湡
                  <input
                    type="date"
                    value={record?.watchDate ?? ""}
                    onChange={(event) => props.updateRecord(movie.id, { watchDate: event.target.value })}
                  />
                </label>
                <label>
                  鐗囧崟
                  <input
                    value={record?.lists.join("銆?) ?? ""}
                    onChange={(event) => props.updateRecord(movie.id, { lists: splitText(event.target.value) })}
                  />
                </label>
                <label className="wide">
                  鐭瘎
                  <textarea
                    value={record?.review ?? ""}
                    onChange={(event) => props.updateRecord(movie.id, { review: event.target.value })}
                  />
                </label>
              </>
            )}
          </div>
          {props.detailed && (
            <div className="actions">
              {props.editMovie && <button onClick={() => props.editMovie?.(movie)}>缂栬緫褰辩墖</button>}
              {props.deleteMovie && <button className="danger" onClick={() => props.deleteMovie?.(movie.id)}>鍒犻櫎</button>}
            </div>
          )}
        </article>
      ))}
    </div>
  );
}

function recommend(
  rows: { movie: Movie; record?: UserMovieRecord }[],
  picker: PickerInput,
  profile: UserProfile,
  skippedIds: string[],
) {
  return rows
    .filter(({ movie, record }) => record?.status !== "寮冪湅" && !skippedIds.includes(movie.id))
    .map(({ movie, record }) => {
      let score = 0;
      const reasons: string[] = [];
      const timeDiff = Math.abs(movie.durationMinutes - picker.availableMinutes);
      if (movie.durationMinutes <= picker.availableMinutes + 15) {
        score += Math.max(0, 25 - Math.floor(timeDiff / 8));
        reasons.push(`鐗囬暱 ${movie.durationMinutes} 鍒嗛挓锛岃创杩戜綘褰撳墠 ${picker.availableMinutes} 鍒嗛挓鐨勫彲鐢ㄦ椂闂淬€俙);
      }
      if (movie.moods.includes(picker.mood)) {
        score += 20;
        reasons.push(`鍐呭姘旇川鍖归厤鈥?{picker.mood}鈥濆績鎯呫€俙);
      }
      const genreMatches = movie.genres.filter((genre) => picker.genres.includes(genre));
      if (genreMatches.length) {
        score += Math.min(20, genreMatches.length * 8);
        reasons.push(`绫诲瀷鍛戒腑锛?{genreMatches.join("銆?)}銆俙);
      }
      const platformMatches = movie.platforms.filter((platform) => picker.platforms.includes(platform.platformName));
      if (platformMatches.length) {
        score += 15;
        reasons.push(`鍙湪 ${platformMatches.map((item) => item.platformName).join("銆?)} 瑙傜湅銆俙);
      }
      if (movie.companions.includes(picker.companion)) {
        score += 10;
        reasons.push(`閫傚悎${picker.companion}瑙傜湅銆俙);
      }
      if (record?.priority === "寰堟兂鐪?) {
        score += 5;
        reasons.push("浣犱箣鍓嶆爣璁拌繃鈥滃緢鎯崇湅鈥濄€?);
      }
      if (record && daysSince(record.createdAt) > 14) {
        score += 5;
        reasons.push("宸茬粡鍦ㄧ墖鍗曢噷绛夊緟浜嗕竴娈垫椂闂淬€?);
      }
      if (!genreMatches.length && profile.favoriteGenres.some((genre) => movie.genres.includes(genre))) {
        score += 4;
        reasons.push("绗﹀悎浣犵殑甯哥湅绫诲瀷鍋忓ソ銆?);
      }
      return { movie, record, score, reasons: reasons.length ? reasons : ["缁煎悎鐗囬暱銆佺被鍨嬪拰骞冲彴鍚庣粰鍑虹殑鍊欓€夈€?] };
    })
    .filter((item) => item.score > 0)
    .sort((a, b) => b.score - a.score)
    .slice(0, 3);
}

function calcGenreScores(rows: { movie: Movie; record?: UserMovieRecord }[], profile: UserProfile) {
  const scores: Record<string, number> = {};
  for (const genre of profile.favoriteGenres) scores[genre] = (scores[genre] ?? 0) + 6;
  for (const { movie, record } of rows) {
    for (const genre of movie.genres) {
      if (!scores[genre]) scores[genre] = 0;
      if (record?.status === "宸茬湅") scores[genre] += 8;
      if (record?.status === "鎯崇湅") scores[genre] += 3;
      if (normalizeRating(record?.rating ?? 0) >= 4) scores[genre] += 5;
      if (record) scores[genre] += 2;
    }
  }
  return Object.entries(scores)
    .map(([genre, score]) => ({ genre, score }))
    .sort((a, b) => b.score - a.score);
}

function calcSummary(rows: { movie: Movie; record?: UserMovieRecord }[]) {
  const watched = rows.filter(({ record }) => record?.status === "宸茬湅" || (record?.rating ?? 0) > 0);
  const ratings = watched.map(({ record }) => normalizeRating(record?.rating ?? 0)).filter(Boolean);
  const platformMap: Record<string, number> = {};
  for (const { record } of watched) {
    const platform = record?.watchPlatform || "鏈褰曞钩鍙?;
    platformMap[platform] = (platformMap[platform] ?? 0) + 1;
  }
  return {
    watchedCount: watched.length,
    totalMinutes: watched.reduce((sum, { movie }) => sum + movie.durationMinutes, 0),
    averageRating: ratings.length ? (ratings.reduce((sum, item) => sum + item, 0) / ratings.length).toFixed(1) : "",
    rewatchCount: rows.filter(({ record }) => record?.tags.includes("浜屽埛")).length,
    platformMap,
  };
}

function calcRatingRank(rows: { movie: Movie; record?: UserMovieRecord }[]) {
  return rows
    .map(({ movie, record }) => ({
      movie,
      value: normalizeRating(record?.rating ?? 0),
    }))
    .filter((item) => item.value > 0)
    .sort((a, b) => b.value - a.value || b.movie.year - a.movie.year)
    .slice(0, 5);
}

function calcSearchHeatRank(rows: { movie: Movie; record?: UserMovieRecord }[]) {
  return rows
    .map(({ movie, record }, index) => {
      const recency = Math.max(0, movie.year - 2015);
      const platformBoost = movie.platforms.length * 7;
      const typeBoost = movie.type === "鐭墽" ? 30 : movie.type === "缁艰壓" ? 24 : movie.type === "鍓ч泦" ? 16 : 8;
      const statusBoost = record?.status === "鍦ㄧ湅" ? 22 : record?.status === "鎯崇湅" ? 12 : record?.status === "宸茬湅" ? 8 : 0;
      const ratingBoost = normalizeRating(record?.rating ?? 0) * 5;
      return {
        movie,
        value: recency + platformBoost + typeBoost + statusBoost + ratingBoost + (index % 9),
      };
    })
    .sort((a, b) => b.value - a.value)
    .slice(0, 5);
}

function calcTagHeatRank(rows: { movie: Movie; record?: UserMovieRecord }[], tags: string[]) {
  return rows
    .filter(({ movie }) => tags.some((tag) => movie.genres.includes(tag) || movie.type === tag))
    .map((row, index) => ({
      movie: row.movie,
      value: calcHeatValue(row, index),
    }))
    .sort((a, b) => b.value - a.value)
    .slice(0, 6);
}

function calcShortDramaRank(rows: { movie: Movie; record?: UserMovieRecord }[]) {
  return rows
    .filter(({ movie }) => movie.type === "鐭墽" || movie.genres.includes("鐭墽"))
    .map((row, index) => ({
      movie: row.movie,
      value: calcHeatValue(row, index) + 20,
    }))
    .sort((a, b) => b.value - a.value)
    .slice(0, 6);
}

function calcYingjiRank(rows: { movie: Movie; record?: UserMovieRecord }[]) {
  return rows
    .map(({ movie, record }, index) => {
      const rating = normalizeRating(record?.rating ?? 0);
      const status = record?.status === "宸茬湅" ? 24 : record?.status === "鍦ㄧ湅" ? 18 : record?.status === "鎯崇湅" ? 10 : 0;
      const progress = Math.round((record?.progress ?? 0) / 5);
      const listBoost = (record?.lists.length ?? 0) * 5;
      return {
        movie,
        value: rating * 18 + status + progress + listBoost + (index % 7),
      };
    })
    .filter((item) => item.value > 0)
    .sort((a, b) => b.value - a.value)
    .slice(0, 8);
}

function calcCategoryRanks(rows: { movie: Movie; record?: UserMovieRecord }[]) {
  const labels = ["鐭墽", "鍙よ", "閮藉競", "鎮枒", "鐖辨儏", "鍠滃墽", "缁艰壓", "绾綍鐗?, "鍔ㄧ敾"];
  return labels
    .map((label) => ({
      label,
      items: calcTagHeatRank(rows, [label]),
    }))
    .filter((group) => group.items.length > 0);
}

function calcHeatValue(row: { movie: Movie; record?: UserMovieRecord }, index: number) {
  const recency = Math.max(0, row.movie.year - 2015);
  const platformBoost = row.movie.platforms.length * 7;
  const typeBoost = row.movie.type === "鐭墽" ? 30 : row.movie.type === "缁艰壓" ? 24 : row.movie.type === "鍓ч泦" ? 16 : 8;
  const statusBoost = row.record?.status === "鍦ㄧ湅" ? 22 : row.record?.status === "鎯崇湅" ? 12 : row.record?.status === "宸茬湅" ? 8 : 0;
  const ratingBoost = normalizeRating(row.record?.rating ?? 0) * 5;
  return recency + platformBoost + typeBoost + statusBoost + ratingBoost + (index % 9);
}

function normalizeRating(value: number) {
  if (!Number.isFinite(value) || value <= 0) return 0;
  const normalized = value > 5 ? Math.round(value / 2) : Math.round(value);
  return Math.min(5, Math.max(1, normalized));
}

function inferMoods(genres: string[]): Mood[] {
  const moods = new Set<Mood>();
  if (genres.some((genre) => ["鍠滃墽", "鍔ㄧ敾", "鍐掗櫓", "缁艰壓", "鐢滃疇", "鐭墽"].includes(genre))) moods.add("杞绘澗");
  if (genres.some((genre) => ["鍔ㄤ綔", "鐘姜", "鎮枒", "閫嗚", "鐖藉墽"].includes(genre))) moods.add("鍒烘縺");
  if (genres.some((genre) => ["娌绘剤", "瀹跺涵", "绾綍鐗?].includes(genre))) moods.add("娌绘剤");
  if (genres.some((genre) => ["绉戝够", "鎮枒"].includes(genre))) moods.add("鐑ц剳");
  return moods.size ? [...moods] : ["杞绘澗"];
}

function inferCompanions(genres: string[], type: ContentType): Companion[] {
  const companions = new Set<Companion>(["鐙嚜"]);
  if (genres.some((genre) => ["鐖辨儏", "娌绘剤"].includes(genre))) companions.add("鎯呬荆");
  if (genres.some((genre) => ["鍠滃墽", "鍔ㄤ綔", "绉戝够", "鎮枒"].includes(genre))) companions.add("鏈嬪弸");
  if (genres.some((genre) => ["鍔ㄧ敾", "瀹跺涵", "绾綍鐗?, "缁艰壓"].includes(genre)) || type === "鍔ㄦ极") companions.add("瀹跺涵");
  if (type === "鐭墽") companions.add("鏈嬪弸");
  return [...companions];
}

function isSenior(ageRange: string) {
  return ["55-64", "65浠ヤ笂"].includes(ageRange);
}

function daysSince(date: string) {
  return Math.floor((Date.now() - new Date(date).getTime()) / 86400000);
}

function secondsLabel(totalSeconds: number) {
  const safeSeconds = Math.max(0, Math.floor(totalSeconds));
  const minutes = Math.floor(safeSeconds / 60);
  const seconds = String(safeSeconds % 60).padStart(2, "0");
  return `${minutes}:${seconds}`;
}

function timeLabel(value: string) {
  return new Intl.DateTimeFormat("zh-CN", {
    hour: "2-digit",
    minute: "2-digit",
  }).format(new Date(value));
}

function Metric({ label, value }: { label: string; value: string | number }) {
  return (
    <article className="metric">
      <span>{label}</span>
      <strong>{value}</strong>
    </article>
  );
}

function RankList({
  title,
  items,
  valueSuffix,
  onSelect,
}: {
  title: string;
  items: { movie: Movie; value: number }[];
  valueSuffix: string;
  onSelect?: (movie: Movie) => void;
}) {
  return (
    <section className="rank-card">
      <h2>{title}</h2>
      <div className="rank-list">
        {items.length ? items.map((item, index) => (
          <button className="rank-item" key={item.movie.id} onClick={() => onSelect?.(item.movie)}>
            <b>{index + 1}</b>
            <span className="poster rank-poster">{item.movie.poster}</span>
            <div>
              <strong>{item.movie.title}</strong>
              <span>{item.movie.type} 路 {item.movie.year}</span>
            </div>
            <em>{item.value}{valueSuffix}</em>
          </button>
        )) : <p>鏆傛棤鏁版嵁</p>}
      </div>
    </section>
  );
}

function RatingControl({ value, onChange }: { value: number; onChange: (value: number) => void }) {
  return (
    <div className="rating-control" aria-label="瑙傚奖璇勫垎">
      <select value={value} onChange={(event) => onChange(Number(event.target.value))}>
        <option value={0}>鏈瘎鍒?/option>
        {[1, 2, 3, 4, 5].map((score) => (
          <option value={score} key={score}>{score} 鍒?/option>
        ))}
      </select>
      <span aria-hidden="true">{"鈽呪槄鈽呪槄鈽?.slice(0, value)}{"鈽嗏槅鈽嗏槅鈽?.slice(value)}</span>
    </div>
  );
}

function MovieDetailModal(props: {
  row?: { movie: Movie; record?: UserMovieRecord };
  close: () => void;
  updateRecord: (movieId: string, patch: Partial<UserMovieRecord>) => void;
  startSoloWatch: (movie: Movie, startSeconds?: number) => void;
  startWatchParty: (movie: Movie, startSeconds?: number) => void;
}) {
  if (!props.row) return null;
  const { movie, record } = props.row;
  return (
    <div className="modal-backdrop" role="dialog" aria-modal="true" aria-label={`${movie.title}璇︽儏`} onClick={props.close}>
      <article className="movie-modal" onClick={(event) => event.stopPropagation()}>
        <button className="modal-close" onClick={props.close} aria-label="鍏抽棴璇︽儏">脳</button>
        <div className="modal-head">
          <span className="poster">{movie.poster}</span>
          <div>
            <p className="eyebrow">{movie.type} 路 {movie.year}</p>
            <h1>{movie.title}</h1>
            <p>{movie.alias || "鏆傛棤鍒悕"} 路 {movie.durationMinutes} 鍒嗛挓 路 {record?.status ?? "鏈敹钘?}</p>
          </div>
        </div>
        <p>{movie.summary || "鏆傛棤绠€浠?}</p>
        <div className="chips">
          {movie.genres.map((genre) => <span className="chip strong" key={genre}>{genre}</span>)}
        </div>
        {!!movie.actors.length && <p>涓绘紨/鍢夊锛歿movie.actors.join("銆?)}</p>}
        <div className="platform-tags">
          {movie.platforms.length ? movie.platforms.map((platform) => (
            <a href={playableUrl(platform, movie.title)} key={platform.platformName} rel="noreferrer" target="_blank">
              {platform.platformName} 路 {platform.watchType}
            </a>
          )) : <span>鏆傛棤骞冲彴淇℃伅</span>}
        </div>
        <div className="modal-actions">
          <RatingControl
            value={normalizeRating(record?.rating ?? 0)}
            onChange={(rating) => props.updateRecord(movie.id, { rating, status: rating > 0 ? "宸茬湅" : record?.status })}
          />
          <button onClick={() => props.updateRecord(movie.id, { status: "鍦ㄧ湅", progress: Math.max(record?.progress ?? 0, 10) })}>
            鏍囪鍦ㄧ湅
          </button>
          <button onClick={() => props.startSoloWatch(movie, Math.floor(movie.durationMinutes * 60 * ((record?.progress ?? 0) / 100)))}>
            鐩存帴瑙傜湅
          </button>
          <button className="primary" onClick={() => props.startWatchParty(movie)}>
            閭€璇峰叡鐪?          </button>
        </div>
      </article>
    </div>
  );
}

function Panel({ title, children }: { title: string; children: React.ReactNode }) {
  return (
    <section className="panel">
      <h2>{title}</h2>
      {children}
    </section>
  );
}

function PageHeader({ title, description }: { title: string; description: string }) {
  return (
    <header className="page-header">
      <p className="eyebrow">CineList</p>
      <h1>{title}</h1>
      <p>{description}</p>
    </header>
  );
}

function Input({ label, value, onChange, required }: { label: string; value: string; onChange: (value: string) => void; required?: boolean }) {
  return (
    <label>
      {label}
      <input required={required} value={value} onChange={(event) => onChange(event.target.value)} />
    </label>
  );
}

function CheckboxGroup({ label, options, values, onChange }: { label: string; options: string[]; values: string[]; onChange: (values: string[]) => void }) {
  return (
    <fieldset>
      <legend>{label}</legend>
      <div className="chips selectable">
        {options.map((option) => (
          <button
            type="button"
            className={values.includes(option) ? "chip selected" : "chip"}
            key={option}
            onClick={() => onChange(values.includes(option) ? values.filter((item) => item !== option) : [...values, option])}
          >
            {option}
          </button>
        ))}
      </div>
    </fieldset>
  );
}

function BarList({ items }: { items: { label: string; value: number }[] }) {
  const max = Math.max(...items.map((item) => item.value), 1);
  if (!items.length) return <EmptyState text="鏆傛棤缁熻鏁版嵁銆? />;
  return (
    <div className="bar-list">
      {items.map((item) => (
        <div className="bar-row" key={item.label}>
          <span>{item.label}</span>
          <div><i style={{ width: `${(item.value / max) * 100}%` }} /></div>
          <b>{item.value}</b>
        </div>
      ))}
    </div>
  );
}

function EmptyState({ text }: { text: string }) {
  return <div className="empty">{text}</div>;
}

export default App;
