function platformSearchUrl(platformName: string, title: string) {
  const keyword = encodeURIComponent(title);
  const urls: Record<string, string> = {
    鑵捐瑙嗛: `https://v.qq.com/x/search/?q=${keyword}`,
    鐖卞鑹? `https://so.iqiyi.com/so/q_${keyword}`,
    浼橀叿: `https://so.youku.com/search_video?keyword=${keyword}`,
    鍝斿摡鍝斿摡: `https://search.bilibili.com/all?keyword=${keyword}`,
    鑺掓灉TV: `https://so.mgtv.com/so?k=${keyword}`,
    澶棰? `https://www.yangshipin.cn/search?keyword=${keyword}`,
    绾㈡灉鐭墽: `https://www.baidu.com/s?wd=${keyword}%20${encodeURIComponent("绾㈡灉鐭墽")}`,
    鎶栭煶鐭墽: `https://www.douyin.com/search/${keyword}?type=general`,
    蹇墜灏忓墽鍦? `https://www.kuaishou.cn/theater/0`,
    Netflix: `https://www.netflix.com/search?q=${keyword}`,
    "Disney+": `https://www.disneyplus.com/search?q=${keyword}`,
    "Apple TV+": `https://tv.apple.com/search?term=${keyword}`,
  };
  return urls[platformName] ?? `https://www.baidu.com/s?wd=${keyword}%20${encodeURIComponent(platformName)}`;
}

function webSearchTargets(keyword: string): WebSearchTarget[] {
  const encoded = encodeURIComponent(keyword.trim());
  if (!encoded) return [];
  return [
    {
      name: "璞嗙摚鐢靛奖",
      description: "鏌ヨ瘎鍒嗐€佺畝浠嬨€佹紨鍛樺拰褰辫瘎",
      url: `https://search.douban.com/movie/subject_search?search_text=${encoded}`,
    },
    {
      name: "鐧惧害",
      description: "缁煎悎缃戦〉缁撴灉鍜岀櫨绉戜俊鎭?,
      url: `https://www.baidu.com/s?wd=${encoded}%20鐢靛奖`,
    },
    {
      name: "Bing",
      description: "缁煎悎缃戦〉鍜屽浗闄呯墖鍚嶇粨鏋?,
      url: `https://www.bing.com/search?q=${encoded}%20movie`,
    },
    ...platformOptions.map((platformName) => ({
      name: platformName,
      description: "鎼滅储鍙鐪嬪叆鍙?,
      url: platformSearchUrl(platformName, keyword),
    })),
  ];
}

function makePlatform(platformName: string, title: string, watchType = "鎼滅储鍏ュ彛"): PlatformAvailability {
  return {
    platformName,
    region: platformName === "Netflix" || platformName === "Disney+" || platformName === "Apple TV+" ? "鍏ㄧ悆閮ㄥ垎鍦板尯" : "涓浗澶ч檰",
    watchType,
    url: platformSearchUrl(platformName, title),
    lastCheckedAt: today,
    available: true,
  };
}

function playableUrl(platform: PlatformAvailability, title: string) {
  const homePages = new Set([
    "https://v.qq.com",
    "https://www.iqiyi.com",
    "https://www.disneyplus.com",
    "https://www.bilibili.com",
    "https://www.youku.com",
  ]);
  return homePages.has(platform.url.replace(/\/$/, "")) ? platformSearchUrl(platform.platformName, title) : platform.url;
}

function openPlaybackResource(platform: PlatformAvailability | undefined, title: string) {
  if (!platform?.url) {
    window.alert("鏆傛椂鏃犳硶鎵惧埌褰辫璧勬簮");
    return false;
  }
  const playbackWindow = window.open(playableUrl(platform, title), "_blank");
  if (!playbackWindow) {
    window.alert("鎾斁绐楀彛琚祻瑙堝櫒鎷︽埅浜嗭紝璇峰厑璁告湰绔欏脊鍑虹獥鍙ｅ悗閲嶈瘯銆?);
    return false;
  }
  playbackWindow.opener = null;
  return true;
}

