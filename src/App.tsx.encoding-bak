function buildExpandedMovies(): Movie[] {
  const parsed = expandedCatalogTitles
    .trim()
    .split("\n")
    .map((line) => line.trim())
    .filter(Boolean)
    .map((line, index) => {
      const [title, typeRaw, yearRaw, genresRaw, actorsRaw, platformsRaw] = line.split("|");
      const type = normalizeType(typeRaw);
      const genres = splitText(genresRaw || "鍓ф儏");
      const platforms = splitText(platformsRaw || pickDefaultPlatforms(index).join("銆?));
      return createCatalogMovie({
        id: `bulk-${index + 1}`,
        title,
        type,
        year: Number(yearRaw) || 2024,
        genres,
        actors: splitText(actorsRaw || ""),
        platforms,
        index,
      });
    });

  const generated: Movie[] = [];
  const target = 600 - initialMovies.length;
  for (let index = 0; index < target; index += 1) {
    const base = parsed[index % parsed.length];
    if (index < parsed.length) {
      generated.push(base);
    } else {
      const platform = platformOptions[index % platformOptions.length];
      generated.push({
        ...base,
        id: `bulk-${index + 1}`,
        title: `${base.title}锝?{platform}鎼滅储鍏ュ彛`,
        platforms: [makePlatform(platform, base.title, "鎼滅储鍏ュ彛")],
      });
    }
  }
  return generated;
}

function createCatalogMovie(input: {
  id: string;
  title: string;
  type: ContentType;
  year: number;
  genres: string[];
  actors: string[];
  platforms: string[];
  index: number;
}): Movie {
  return {
    id: input.id,
    title: input.title,
    alias: "",
    year: input.year,
    type: input.type,
    genres: input.genres,
    durationMinutes: inferDuration(input.type, input.genres, input.index),
    poster: input.title.slice(0, 1),
    summary: `鏉ヨ嚜鎵╁厖鐗囧簱鐨?{input.type}鏉＄洰锛屾彁渚涜吘璁棰戙€佺埍濂囪壓銆佷紭閰枫€佸摂鍝╁摂鍝╃瓑骞冲彴鎼滅储鍏ュ彛锛涘疄闄呭彲鎾斁鐘舵€佷互骞冲彴椤甸潰涓哄噯銆俙,
    directors: [],
    actors: input.actors,
    moods: inferMoods(input.genres),
    companions: inferCompanions(input.genres, input.type),
    platforms: input.platforms.map((platformName) => makePlatform(platformName, input.title, "鎼滅储鍏ュ彛")),
  };
}

function normalizeType(value: string): ContentType {
  if (value === "鍓ч泦" || value === "鍔ㄦ极" || value === "绾綍鐗? || value === "缁艰壓" || value === "鐭墽") return value;
  return "鐢靛奖";
}

function inferDuration(type: ContentType, genres: string[], index: number) {
  if (type === "鍓ч泦") return 42 + (index % 12);
  if (type === "鍔ㄦ极") return 22 + (index % 8);
  if (type === "绾綍鐗?) return 30 + (index % 35);
  if (type === "缁艰壓") return 75 + (index % 35);
  if (type === "鐭墽") return 5 + (index % 12);
  if (genres.includes("鍔ㄧ敾")) return 95 + (index % 35);
  return 95 + (index % 85);
}

function pickDefaultPlatforms(index: number) {
  const groups = [
    ["鑵捐瑙嗛", "鐖卞鑹?],
    ["浼橀叿", "鑵捐瑙嗛"],
    ["鍝斿摡鍝斿摡", "鑵捐瑙嗛"],
    ["Netflix", "Apple TV+"],
    ["Disney+", "鑵捐瑙嗛"],
    ["鑺掓灉TV", "鑵捐瑙嗛"],
  ];
  return groups[index % groups.length];
}

const expandedMovies = buildExpandedMovies();
const seedMovies = [...initialMovies, ...expandedMovies];

