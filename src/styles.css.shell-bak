:root {
  color: #17211d;
  background: #f6f3ed;
  font-family:
    Inter, "Microsoft YaHei", "PingFang SC", "Noto Sans CJK SC", Arial,
    sans-serif;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 320px;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  min-height: 40px;
  border: 1px solid #d4d8d1;
  border-radius: 8px;
  color: #1d2c25;
  background: #ffffff;
  cursor: pointer;
  transition:
    transform 0.16s ease,
    border-color 0.16s ease,
    background 0.16s ease;
}

button:hover {
  border-color: #2f7258;
  transform: translateY(-1px);
}

button:disabled {
  cursor: not-allowed;
  opacity: 0.48;
  transform: none;
}

button.primary,
button.active,
.segmented .selected {
  border-color: #0d6549;
  color: #ffffff;
  background: #0d6549;
}

button.danger {
  color: #9e2f2f;
  border-color: #e6b9b2;
}

.icon-button {
  width: 44px;
  min-width: 44px;
  padding: 0;
  font-size: 1.35rem;
  line-height: 1;
}

.button-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 40px;
  padding: 0 14px;
  border: 1px solid #d4d8d1;
  border-radius: 8px;
  color: #1d2c25;
  background: #ffffff;
  text-decoration: none;
}

input,
select,
textarea {
  width: 100%;
  min-height: 42px;
  padding: 10px 12px;
  border: 1px solid #d7d8d0;
  border-radius: 8px;
  color: #17211d;
  background: #fffefa;
}

textarea {
  min-height: 86px;
  resize: vertical;
}

label,
fieldset {
  display: grid;
  gap: 7px;
  margin: 0;
  border: 0;
  padding: 0;
  color: #4e5d55;
  font-size: 0.92rem;
}

legend {
  margin-bottom: 8px;
  color: #4e5d55;
}

main {
  display: grid;
  grid-template-columns: 260px minmax(0, 1fr);
  min-height: 100vh;
}

.rail {
  position: sticky;
  top: 0;
  display: flex;
  flex-direction: column;
  gap: 22px;
  height: 100vh;
  padding: 24px 18px;
  border-right: 1px solid #e2dfd6;
  background: #fbfaf6;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-mark,
.poster {
  display: inline-grid;
  flex: 0 0 auto;
  place-items: center;
  width: 54px;
  height: 72px;
  border: 1px solid #214f42;
  border-radius: 8px;
  color: #fff;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.1), transparent),
    #17352d;
  font-size: 1.5rem;
  font-weight: 800;
  box-shadow: 0 12px 28px rgba(27, 42, 35, 0.16);
}

.brand-mark {
  width: 46px;
  height: 46px;
  border-radius: 8px;
}

.brand strong,
.brand small {
  display: block;
}

.brand small,
.eyebrow,
.metric span,
.subtitle-card span {
  color: #6f7b74;
  font-size: 0.82rem;
}

.rail nav {
  display: grid;
  gap: 8px;
}

.rail nav button {
  justify-content: flex-start;
  width: 100%;
  padding-inline: 14px;
  text-align: left;
}

.subtitle-card {
  margin-top: auto;
  padding: 16px;
  border: 1px solid #dfe3dd;
  border-radius: 8px;
  background: #eef4ef;
}

.subtitle-card strong {
  display: block;
  margin-top: 6px;
  font-size: 1.8rem;
}

.account-card {
  display: grid;
  gap: 8px;
  padding: 14px;
  border: 1px solid #dfe3dd;
  border-radius: 8px;
  background: #fffefa;
}

.account-card span,
.account-card small {
  color: #6f7b74;
  font-size: 0.82rem;
}

.account-card strong {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.workspace {
  padding: 28px;
  overflow: hidden;
}

.auth-shell {
  display: grid;
  grid-template-columns: minmax(0, 520px);
  place-content: center;
  min-height: 100vh;
  padding: 24px;
  background:
    linear-gradient(135deg, rgba(13, 101, 73, 0.12), transparent 52%),
    #f6f3ed;
}

.auth-panel {
  display: grid;
  gap: 22px;
  padding: 28px;
  border: 1px solid #ddd9ce;
  border-radius: 8px;
  background: #fffefa;
  box-shadow: 0 24px 70px rgba(34, 44, 39, 0.12);
}

.auth-panel h1 {
  margin-bottom: 10px;
  font-size: clamp(2rem, 8vw, 3.4rem);
}

.auth-form {
  display: grid;
  gap: 14px;
}

.form-error {
  margin: 0;
  color: #9e2f2f;
}

.text-button {
  justify-self: start;
  min-height: auto;
  padding: 0;
  border: 0;
  color: #0d6549;
  background: transparent;
}

.guest-button {
  width: 100%;
  border-color: #b8c8bf;
  color: #0d6549;
  background: #eef4ef;
}

.guest-note {
  margin: -8px 0 0;
  color: #6f7b74;
  font-size: 0.86rem;
}

.page-stack {
  display: grid;
  gap: 22px;
  max-width: 1280px;
  margin: 0 auto;
}

.page-header-actions {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
}

.page-header-actions header {
  flex: 1 1 auto;
}

.page-header-actions button {
  flex: 0 0 auto;
}

.hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 340px;
  gap: 24px;
  align-items: stretch;
  padding: 34px;
  border: 1px solid #ddd9ce;
  border-radius: 8px;
  background:
    linear-gradient(135deg, rgba(13, 101, 73, 0.12), transparent 48%),
    #fffdfa;
}

h1,
h2,
h3,
p {
  margin-top: 0;
}

h1 {
  max-width: 760px;
  margin-bottom: 12px;
  font-size: clamp(2.1rem, 5vw, 4.6rem);
  line-height: 1.02;
  letter-spacing: 0;
}

h2 {
  margin-bottom: 16px;
  font-size: 1.16rem;
}

h3 {
  margin-bottom: 6px;
  font-size: 1rem;
}

p {
  color: #526058;
  line-height: 1.65;
}

.search-row,
.toolbar,
.actions,
.section-title,
.segmented {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  align-items: center;
}

.search-row input,
.toolbar input {
  flex: 1 1 260px;
}

.search-results {
  display: grid;
  gap: 14px;
  padding: 20px;
  border: 1px solid #e0ded5;
  border-radius: 8px;
  background: #fffefa;
  box-shadow: 0 18px 40px rgba(34, 44, 39, 0.06);
}

.search-results .section-title span {
  color: #0d6549;
  font-weight: 700;
}

.result-grid {
  display: grid;
  gap: 14px;
}

.result-card {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  gap: 16px;
  align-items: start;
  padding: 16px;
  border: 1px solid #e4e6df;
  border-radius: 8px;
  background: #fbfcf8;
}

.platform-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 10px;
}

.platform-tags span,
.platform-tags a {
  padding: 8px 10px;
  border-radius: 8px;
  color: #345248;
  background: #f2f1eb;
  font-size: 0.88rem;
  text-decoration: none;
}

.platform-tags a:hover {
  color: #0d6549;
  background: #e8f2ec;
}

.result-actions {
  display: grid;
  gap: 10px;
  min-width: 84px;
}

.result-rating {
  grid-column: 2 / -1;
}

.online-search {
  display: grid;
  gap: 12px;
  margin-top: 4px;
  padding-top: 18px;
  border-top: 1px solid #ecebe4;
}

.online-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
}

.online-grid a {
  display: grid;
  gap: 4px;
  min-height: 82px;
  padding: 12px;
  border: 1px solid #d9ddd6;
  border-radius: 8px;
  color: #1d2c25;
  background: #f7f9f4;
  text-decoration: none;
}

.online-grid a:hover {
  border-color: #0d6549;
  background: #eaf4ee;
}

.online-grid span {
  color: #637069;
  font-size: 0.86rem;
  line-height: 1.45;
}

.resume-strip {
  display: grid;
  gap: 10px;
  max-width: 760px;
  margin-top: 18px;
  padding: 14px;
  border: 1px solid #dfe5dc;
  border-radius: 8px;
  background: rgba(255, 254, 250, 0.82);
}

.resume-strip h2 {
  margin-bottom: 0;
  font-size: 1rem;
}

.resume-strip .section-title span,
.resume-empty {
  color: #6f7b74;
  font-size: 0.84rem;
}

.resume-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
}

.resume-item {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  gap: 10px;
  align-items: center;
  min-height: 58px;
  padding: 8px;
  text-align: left;
}

.resume-item strong {
  display: block;
  overflow: hidden;
  margin-bottom: 6px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.resume-item i {
  display: block;
  height: 7px;
  overflow: hidden;
  border-radius: 999px;
  background: #e5e8df;
}

.resume-item i span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: #0d6549;
}

.resume-item em {
  color: #0d6549;
  font-style: normal;
  font-weight: 800;
}

.hero-panel,
.rank-card,
.metric,
.panel,
.movie-card,
.recommend-card,
.editor,
.picker-panel {
  border: 1px solid #e0ded5;
  border-radius: 8px;
  background: #fffefa;
  box-shadow: 0 18px 40px rgba(34, 44, 39, 0.06);
}

.hero-panel {
  display: grid;
  align-content: center;
  padding: 24px;
}

.home-side {
  display: grid;
  gap: 12px;
}

.hero-panel strong {
  font-size: 4rem;
  line-height: 1;
}

.rank-card {
  padding: 16px;
}

.rank-card h2 {
  margin-bottom: 10px;
}

.rank-list {
  display: grid;
  gap: 8px;
}

.rank-list .rank-item {
  display: grid;
  grid-template-columns: 24px 36px minmax(0, 1fr) auto;
  gap: 10px;
  align-items: center;
  width: 100%;
  min-height: auto;
  padding: 8px 0;
  border: 0;
  border-bottom: 1px solid #eeeae0;
  border-radius: 0;
  background: transparent;
  text-align: left;
}

.rank-list .rank-item:hover {
  background: #f3f7f2;
  transform: none;
}

.rank-list .rank-item:last-child {
  border-bottom: 0;
}

.rank-list b {
  display: grid;
  place-items: center;
  width: 24px;
  height: 24px;
  border-radius: 999px;
  color: #ffffff;
  background: #0d6549;
  font-size: 0.78rem;
}

.rank-poster {
  width: 36px;
  height: 48px;
  border-radius: 6px;
  font-size: 1rem;
  box-shadow: 0 8px 18px rgba(27, 42, 35, 0.12);
}

.rank-list strong,
.rank-list span,
.rank-list em {
  display: block;
}

.rank-list strong {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-list span {
  color: #6f7b74;
  font-size: 0.8rem;
}

.rank-list em {
  color: #0d6549;
  font-style: normal;
  font-weight: 800;
  white-space: nowrap;
}

.rating-control {
  display: grid;
  grid-template-columns: minmax(120px, 180px) auto;
  gap: 10px;
  align-items: center;
}

.rating-control select {
  min-height: 38px;
}

.rating-control span {
  color: #c1861b;
  font-size: 1rem;
  letter-spacing: 0;
  white-space: nowrap;
}

.ranking-feature,
.ranking-grid {
  display: grid;
  gap: 16px;
}

.ranking-feature {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.ranking-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.category-ranks {
  display: grid;
  gap: 14px;
}

.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: grid;
  place-items: center;
  padding: 24px;
  background: rgba(18, 27, 23, 0.56);
}

.movie-modal {
  position: relative;
  display: grid;
  gap: 16px;
  width: min(760px, 100%);
  max-height: min(86vh, 820px);
  overflow: auto;
  padding: 24px;
  border: 1px solid #dfe3dd;
  border-radius: 8px;
  background: #fffefa;
  box-shadow: 0 28px 80px rgba(14, 24, 19, 0.28);
}

.modal-close {
  position: absolute;
  top: 12px;
  right: 12px;
  width: 40px;
  min-width: 40px;
  padding: 0;
  font-size: 1.4rem;
}

.modal-head {
  display: flex;
  gap: 16px;
  align-items: flex-start;
  padding-right: 44px;
}

.movie-modal h1 {
  font-size: clamp(1.8rem, 4vw, 3rem);
}

.modal-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  align-items: center;
  padding-top: 12px;
  border-top: 1px solid #eeeae0;
}

.solo-player {
  display: grid;
  gap: 18px;
  border: 1px solid #e0ded5;
  border-radius: 8px;
  background: #fffefa;
  box-shadow: 0 18px 40px rgba(34, 44, 39, 0.06);
}

.solo-screen {
  position: relative;
  display: grid;
  place-items: center;
  min-height: 420px;
  padding: 30px;
  border-radius: 8px 8px 0 0;
  color: #ffffff;
  background:
    radial-gradient(circle at 50% 24%, rgba(255, 255, 255, 0.16), transparent 42%),
    #17211d;
  text-align: center;
}

.solo-screen span {
  display: grid;
  place-items: center;
  width: 86px;
  height: 118px;
  margin-bottom: 18px;
  border: 1px solid rgba(255, 255, 255, 0.35);
  border-radius: 8px;
  background: #0d6549;
  font-size: 2.6rem;
  font-weight: 800;
}

.screen-play-button {
  display: grid;
  place-items: center;
  width: 78px;
  height: 78px;
  min-height: 78px;
  margin: 0 0 18px;
  border: 2px solid rgba(255, 255, 255, 0.76);
  border-radius: 999px;
  color: #ffffff;
  background: #0d6549;
  font-size: 2rem;
  box-shadow: 0 16px 42px rgba(0, 0, 0, 0.28);
}

.screen-play-button:hover {
  border-color: #ffffff;
  background: #12805d;
  transform: scale(1.04);
}

.solo-screen strong {
  font-size: clamp(1.8rem, 4vw, 3.4rem);
}

.solo-screen p {
  color: #dbe6df;
}

.resource-empty {
  margin: 6px 0 0;
  color: #c56b36;
  font-weight: 700;
}

.solo-controls {
  display: grid;
  gap: 14px;
  padding: 20px;
}

.watch-pick-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
}

.watch-pick-card {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  gap: 12px;
  align-items: center;
  min-height: 104px;
  padding: 14px;
  text-align: left;
}

.watch-pick-card strong {
  display: block;
  margin-bottom: 6px;
}

.watch-pick-card p {
  margin-bottom: 8px;
}

.watch-pick-card i {
  display: block;
  height: 8px;
  overflow: hidden;
  border-radius: 999px;
  background: #e5e8df;
}

.watch-pick-card i span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: #0d6549;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
}

.metric {
  padding: 18px;
}

.metric strong {
  display: block;
  margin-top: 8px;
  font-size: 1.8rem;
}

.split,
.settings-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.panel,
.editor,
.picker-panel {
  padding: 20px;
}

.form-grid,
.record-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}

.wide {
  grid-column: 1 / -1;
}

.toolbar {
  justify-content: space-between;
}

.toolbar select {
  max-width: 180px;
}

.movie-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
}

.movie-card {
  display: grid;
  gap: 14px;
  padding: 18px;
}

.movie-top,
.compact-list article {
  display: flex;
  gap: 12px;
  align-items: flex-start;
}

.poster.small {
  width: 34px;
  height: 46px;
  font-size: 1rem;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.chip {
  min-height: 30px;
  padding: 6px 10px;
  border: 1px solid #d9ddd6;
  border-radius: 999px;
  color: #42524a;
  background: #f5f7f3;
  font-size: 0.86rem;
}

.chip.strong,
.chip.selected {
  border-color: #0d6549;
  color: #0d6549;
  background: #e7f2ec;
}

.selectable button {
  min-height: 32px;
}

.platforms {
  display: grid;
  gap: 6px;
  color: #5f6c65;
  font-size: 0.88rem;
}

.platforms span,
.platforms a {
  display: block;
  padding: 8px 10px;
  border-radius: 8px;
  color: #345248;
  background: #f2f1eb;
  text-decoration: none;
}

.platforms a:hover {
  color: #0d6549;
  background: #e8f2ec;
}

.compact-list {
  display: grid;
  gap: 14px;
}

.compact-list article {
  justify-content: space-between;
  padding-bottom: 12px;
  border-bottom: 1px solid #ebe8df;
}

.compact-list article:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.picker-panel {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.picker-panel fieldset {
  grid-column: 1 / -1;
}

.segmented button {
  flex: 1 1 120px;
}

.recommendations {
  display: grid;
  gap: 14px;
}

.section-title {
  justify-content: space-between;
}

.recommend-card {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto auto;
  gap: 18px;
  align-items: start;
  padding: 18px;
}

.card-title {
  display: flex;
  justify-content: space-between;
  gap: 12px;
}

.card-title span {
  color: #0d6549;
  font-weight: 700;
}

.reason-list {
  margin: 10px 0;
  padding-left: 20px;
  color: #526058;
  line-height: 1.6;
}

.bar-list {
  display: grid;
  gap: 12px;
}

.bar-row {
  display: grid;
  grid-template-columns: 88px minmax(0, 1fr) 42px;
  gap: 10px;
  align-items: center;
}

.bar-row div {
  height: 10px;
  overflow: hidden;
  border-radius: 999px;
  background: #ecece5;
}

.bar-row i {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: #0d6549;
}

.toggle-row {
  display: flex;
  align-items: center;
  gap: 10px;
}

.toggle-row input {
  width: auto;
  min-height: auto;
}

.notice {
  padding: 12px;
  border: 1px solid #cddfd3;
  border-radius: 8px;
  color: #0d6549;
  background: #edf7f1;
}

.watch-hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 260px;
  gap: 22px;
  align-items: stretch;
  padding: 30px;
  border: 1px solid #d8ddd5;
  border-radius: 8px;
  color: #f7fbf8;
  background:
    linear-gradient(135deg, rgba(13, 101, 73, 0.96), rgba(23, 33, 29, 0.94)),
    #17211d;
}

.watch-hero h1,
.watch-hero p,
.watch-hero .eyebrow {
  color: inherit;
}

.watch-status {
  display: grid;
  align-content: center;
  padding: 20px;
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.1);
}

.watch-status span {
  color: #dce9e0;
}

.watch-status strong {
  margin-top: 8px;
  font-size: 2rem;
}

.watch-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(340px, 0.8fr);
  gap: 18px;
}

.watch-party-shell {
  display: grid;
  grid-template-columns: minmax(280px, 0.36fr) minmax(0, 0.64fr);
  gap: 18px;
  min-height: 640px;
}

.watch-party-shell + .watch-layout {
  display: none;
}

.watch-chat-pane,
.watch-video-pane {
  display: grid;
  gap: 14px;
  min-height: 0;
  padding: 16px;
  border: 1px solid #d8ddd5;
  border-radius: 8px;
  background: #fffefa;
  box-shadow: 0 18px 40px rgba(34, 44, 39, 0.06);
}

.watch-chat-pane {
  grid-template-rows: auto minmax(0, 1fr) auto;
}

.watch-chat-scroll {
  display: grid;
  align-content: start;
  gap: 10px;
  min-height: 0;
  max-height: 520px;
  overflow: auto;
  padding-right: 4px;
}

.watch-chat-scroll article {
  padding: 12px;
  border: 1px solid #e1e5df;
  border-radius: 8px;
  background: #f8faf6;
}

.watch-chat-scroll article p {
  margin-bottom: 6px;
}

.watch-chat-scroll .system-message {
  border-color: #cddfd3;
  background: #edf7f1;
}

.shell-chat-form {
  margin-top: 0;
}

.watch-video-pane {
  align-content: start;
}

.video-frame {
  position: relative;
  overflow: hidden;
  aspect-ratio: 16 / 9;
  min-height: 360px;
  border: 1px solid #142b25;
  border-radius: 8px;
  background: #101713;
}

.video-frame iframe {
  width: 100%;
  height: 100%;
  border: 0;
  background: #101713;
}

.video-empty {
  display: grid;
  place-items: center;
  height: 100%;
  color: #f7fbf8;
}

.video-empty span {
  font-size: 4rem;
  font-weight: 800;
}

.video-empty p {
  color: #dce9e0;
}

.video-control-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
}

.video-control-bar p {
  margin-bottom: 0;
}

.button-link.disabled {
  pointer-events: none;
  opacity: 0.45;
}

.invite-box {
  display: grid;
  gap: 10px;
  margin-top: 16px;
  padding: 14px;
  border: 1px solid #d9ddd6;
  border-radius: 8px;
  background: #f6f8f4;
}

.invite-box span,
.sync-meta,
.chat-list span {
  color: #6f7b74;
  font-size: 0.84rem;
}

.invite-box code {
  overflow-wrap: anywhere;
  color: #17352d;
}

.room-movie {
  display: flex;
  gap: 14px;
  align-items: flex-start;
  margin-bottom: 14px;
}

.member-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 14px;
}

.sync-stage {
  display: grid;
  grid-template-columns: 140px minmax(0, 1fr);
  gap: 16px;
  align-items: center;
  margin-bottom: 16px;
}

.screen-glow {
  position: relative;
  display: grid;
  place-items: center;
  aspect-ratio: 16 / 10;
  border: 1px solid #213d35;
  border-radius: 8px;
  background:
    radial-gradient(circle at 50% 30%, rgba(255, 255, 255, 0.18), transparent 46%),
    #17211d;
  box-shadow: inset 0 0 0 8px rgba(255, 255, 255, 0.04);
}

.screen-glow span {
  color: #ffffff;
  font-size: 2.4rem;
  font-weight: 800;
}

.screen-glow .screen-play-button {
  position: absolute;
  width: 50px;
  height: 50px;
  min-height: 50px;
  font-size: 1.15rem;
}

.segmented.compact {
  margin-top: 12px;
}

.chat-list {
  display: grid;
  align-content: start;
  gap: 10px;
  min-height: 260px;
  max-height: 360px;
  overflow: auto;
  padding-right: 4px;
}

.chat-list article {
  padding: 12px;
  border: 1px solid #e1e5df;
  border-radius: 8px;
  background: #f8faf6;
}

.chat-list article p {
  margin-bottom: 6px;
}

.chat-list .system-message {
  border-color: #cddfd3;
  background: #edf7f1;
}

.chat-form {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 10px;
  margin-top: 14px;
}

.implementation-note {
  padding: 20px;
  border: 1px solid #d8ddd5;
  border-radius: 8px;
  background: #fffefa;
}

.note-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
}

.note-grid span {
  padding: 10px 12px;
  border: 1px solid #d9ddd6;
  border-radius: 8px;
  color: #345248;
  background: #f4f6f1;
}

.discussion-layout {
  display: grid;
  grid-template-columns: minmax(320px, 0.82fr) minmax(0, 1.18fr);
  gap: 18px;
  align-items: start;
}

.discussion-movie {
  display: flex;
  gap: 16px;
  margin: 16px 0;
}

.discussion-movie h2 {
  margin: 4px 0;
}

.discussion-search-results {
  display: grid;
  gap: 8px;
  margin: 10px 0 14px;
}

.discussion-search-results button {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  min-height: 42px;
  padding: 8px 12px;
  text-align: left;
}

.discussion-search-results button.active {
  border-color: #0d6549;
  color: #0d6549;
  background: #e7f2ec;
}

.discussion-search-results span {
  color: #6f7b74;
  font-size: 0.86rem;
}

.discussion-form,
.discussion-list,
.reply-list {
  display: grid;
  gap: 12px;
}

.discussion-form {
  margin-bottom: 14px;
}

.comment-card {
  display: grid;
  gap: 10px;
  padding: 14px;
  border: 1px solid #e1e5df;
  border-radius: 8px;
  background: #f8faf6;
}

.comment-card.reply {
  margin-left: 26px;
  background: #fffefa;
}

.comment-head {
  display: flex;
  justify-content: space-between;
  gap: 10px;
}

.comment-head span {
  color: #6f7b74;
  font-size: 0.82rem;
}

.like-button {
  justify-self: start;
  min-height: 34px;
  padding: 0 12px;
}

.like-button.active {
  border-color: #0d6549;
  color: #0d6549;
  background: #e7f2ec;
}

.reply-form {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 10px;
}

.subtitle-preview {
  padding: 18px;
  border-radius: 8px;
  color: #ffffff;
  background: #17211d;
  line-height: 1.55;
}

.empty {
  padding: 28px;
  border: 1px dashed #cdd2ca;
  border-radius: 8px;
  color: #68766e;
  background: #faf8f2;
  text-align: center;
}

@media (max-width: 1100px) {
  main {
    grid-template-columns: 1fr;
  }

  .rail {
    position: static;
    height: auto;
  }

  .rail nav {
    grid-template-columns: repeat(7, minmax(0, 1fr));
  }

  .subtitle-card {
    display: none;
  }

  .hero,
  .home-side,
  .ranking-feature,
  .ranking-grid,
  .watch-hero,
  .watch-layout,
  .watch-party-shell,
  .discussion-layout,
  .split,
  .settings-grid,
  .picker-panel {
    grid-template-columns: 1fr;
  }

  .metric-grid,
  .movie-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 720px) {
  .workspace,
  .rail,
  .hero {
    padding: 16px;
  }

  .rail nav {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .metric-grid,
  .movie-grid,
  .watch-pick-grid,
  .resume-list,
  .online-grid,
  .form-grid,
  .record-grid,
  .recommend-card,
  .result-card,
  .rating-control,
  .sync-stage,
  .note-grid {
    grid-template-columns: 1fr;
  }

  .result-rating {
    grid-column: 1;
  }

  .result-actions {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .hero-panel strong {
    font-size: 3rem;
  }

  .section-title,
  .card-title {
    align-items: flex-start;
    flex-direction: column;
  }
}
